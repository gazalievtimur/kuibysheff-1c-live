////////////////////////////////////////////////////////////////////////////////
// Общий модуль РаботаСЦенами (сервер).
// Есть API, но форма РасходТовара его не вызывает.
////////////////////////////////////////////////////////////////////////////////

Функция ЦенаНоменклатуры(Номенклатура, ДатаЦены = Неопределено) Экспорт

	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат 0;
	КонецЕсли;

	Если ДатаЦены = Неопределено Тогда
		ДатаЦены = ТекущаяДатаСеанса();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЦеныНоменклатуры.Цена КАК Цена
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&ДатаЦены, Номенклатура = &Номенклатура) КАК ЦеныНоменклатуры";
	Запрос.УстановитьПараметр("ДатаЦены", ДатаЦены);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);

	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Цена;
	КонецЕсли;

	Возврат 0;

КонецФункции
