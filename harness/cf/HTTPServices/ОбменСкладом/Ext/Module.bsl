////////////////////////////////////////////////////////////////////////////////
// HTTP-сервис ОбменСкладом.
// DEFECT: ОстаткиGET не фильтрует по складу (задача cfe-http-filter-01).
////////////////////////////////////////////////////////////////////////////////

Функция ОстаткиGET(Запрос)

	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");

	// TODO(live): читать query-параметр "склад" и отбирать ОстаткиТоваров по Склад.
	ЗапросОстатков = Новый Запрос;
	ЗапросОстатков.Текст =
	"ВЫБРАТЬ
	|	ОстаткиТоваровОстатки.Номенклатура КАК Номенклатура,
	|	ОстаткиТоваровОстатки.Склад КАК Склад,
	|	ОстаткиТоваровОстатки.КоличествоОстаток КАК Количество
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваров.Остатки КАК ОстаткиТоваровОстатки";

	Результат = ЗапросОстатков.Выполнить().Выгрузить();
	Ответ.УстановитьТелоИзСтроки(СформироватьJSONОстатков(Результат));
	Возврат Ответ;

КонецФункции

Функция СформироватьJSONОстатков(ТаблицаОстатков)

	// Упрощённая сериализация для фикстуры.
	Части = Новый Массив;
	Для Каждого Строка Из ТаблицаОстатков Цикл
		Части.Добавить(СтрШаблон(
			"{""nomenclature"":""%1"",""warehouse"":""%2"",""qty"":%3}",
			Строка(Строка.Номенклатура),
			Строка(Строка.Склад),
			Формат(Строка.Количество, "ЧГ=0")));
	КонецЦикла;
	Возврат "[" + СтрСоединить(Части, ",") + "]";

КонецФункции
