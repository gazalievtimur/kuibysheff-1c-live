#Использовать "./oscript"

Процедура Главная()
	CfDir = "";
	YaxDir = "";
	AgentCfe = "";
	WorkDir = "";
	RequirePlatform = Ложь;
	Инд = 0;
	Аргументы = АргументыКоманднойСтроки;
	Пока Инд < Аргументы.Количество() Цикл
		Арг = Аргументы[Инд];
		Если Арг = "--require-platform" Или Арг = "-RequirePlatform" Тогда
			RequirePlatform = Истина;
		ИначеЕсли Арг = "--cf-dir" Или Арг = "-CfDir" Тогда
			Инд = Инд + 1;
			CfDir = Аргументы[Инд];
		ИначеЕсли Арг = "--yaxunit-dir" Или Арг = "-YaxUnitDir" Тогда
			Инд = Инд + 1;
			YaxDir = Аргументы[Инд];
		ИначеЕсли Арг = "--agent-cfe-dir" Или Арг = "-AgentCfeDir" Тогда
			Инд = Инд + 1;
			AgentCfe = Аргументы[Инд];
		ИначеЕсли Арг = "--work-dir" Или Арг = "-WorkDir" Тогда
			Инд = Инд + 1;
			WorkDir = Аргументы[Инд];
		Иначе
			Сообщить("unknown arg: " + Арг);
			ЗавершитьРаботу(2);
		КонецЕсли;
		Инд = Инд + 1;
	КонецЦикла;
	Если Не ЗначениеЗаполнено(CfDir) Или Не ЗначениеЗаполнено(YaxDir) Или Не ЗначениеЗаполнено(AgentCfe) Или Не ЗначениеЗаполнено(WorkDir) Тогда
		Сообщить("usage: oscript run-yaxunit.os --cf-dir DIR --yaxunit-dir DIR --agent-cfe-dir DIR --work-dir DIR [--require-platform]");
		ЗавершитьРаботу(2);
	КонецЕсли;
	Попытка
		ПлатформенныйШаг.ВыполнитьШаг(CfDir, YaxDir, AgentCfe, WorkDir, RequirePlatform);
		ЗавершитьРаботу(0);
	Исключение
		Сообщить(ОписаниеОшибки());
		ЗавершитьРаботу(1);
	КонецПопытки;
КонецПроцедуры

Главная();
