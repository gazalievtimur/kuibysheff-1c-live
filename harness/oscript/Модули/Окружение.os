// Файлы, окружение, запуск процессов.

Функция ЭтоWindows() Экспорт
	Инфо = Новый СистемнаяИнформация;
	Возврат СтрНачинаетсяС(Строка(Инфо.ТипПлатформы), "Windows");
КонецФункции

Функция АбсолютныйПуть(Путь) Экспорт
	Если Не ЗначениеЗаполнено(Путь) Тогда
		Возврат Путь;
	КонецЕсли;
	Файл = Новый Файл(Путь);
	Возврат Файл.ПолноеИмя;
КонецФункции

Функция ФайлСуществует(Путь) Экспорт
	Если Не ЗначениеЗаполнено(Путь) Тогда
		Возврат Ложь;
	КонецЕсли;
	Файл = Новый Файл(Путь);
	Возврат Файл.Существует() И Файл.ЭтоФайл();
КонецФункции

Функция КаталогСуществует(Путь) Экспорт
	Если Не ЗначениеЗаполнено(Путь) Тогда
		Возврат Ложь;
	КонецЕсли;
	Файл = Новый Файл(Путь);
	Возврат Файл.Существует() И Файл.ЭтоКаталог();
КонецФункции

Функция Существует(Путь) Экспорт
	Если Не ЗначениеЗаполнено(Путь) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Новый Файл(Путь).Существует();
КонецФункции

Функция ИмяФайла(Путь) Экспорт
	Возврат Новый Файл(Путь).Имя;
КонецФункции

Функция ИмяБезРасширения(Путь) Экспорт
	Возврат Новый Файл(Путь).ИмяБезРасширения;
КонецФункции

Функция КаталогФайла(Путь) Экспорт
	Возврат Новый Файл(Путь).Путь;
КонецФункции

Функция РодительскийКаталог(Путь) Экспорт
	Файл = Новый Файл(АбсолютныйПуть(Путь));
	Родитель = Новый Файл(Файл.Путь);
	Возврат Родитель.ПолноеИмя;
КонецФункции

Функция ОбъединитьПуть(Путь1, Путь2, Путь3 = Неопределено, Путь4 = Неопределено, Путь5 = Неопределено, Путь6 = Неопределено) Экспорт
	Результат = ОбъединитьПути(Путь1, Путь2);
	Если Путь3 <> Неопределено Тогда
		Результат = ОбъединитьПути(Результат, Путь3);
	КонецЕсли;
	Если Путь4 <> Неопределено Тогда
		Результат = ОбъединитьПути(Результат, Путь4);
	КонецЕсли;
	Если Путь5 <> Неопределено Тогда
		Результат = ОбъединитьПути(Результат, Путь5);
	КонецЕсли;
	Если Путь6 <> Неопределено Тогда
		Результат = ОбъединитьПути(Результат, Путь6);
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ПозиксОтносительно(Корень, ПолныйПуть) Экспорт
	КореньАбс = АбсолютныйПуть(Корень);
	Полный = АбсолютныйПуть(ПолныйПуть);
	Префикс = КореньАбс;
	Если Не СтрЗаканчиваетсяНа(Префикс, "\") И Не СтрЗаканчиваетсяНа(Префикс, "/") Тогда
		Если ЭтоWindows() Тогда
			Префикс = Префикс + "\";
		Иначе
			Префикс = Префикс + "/";
		КонецЕсли;
	КонецЕсли;
	Если СтрНачинаетсяС(НРег(Полный), НРег(Префикс)) Тогда
		Относительный = Сред(Полный, СтрДлина(Префикс) + 1);
	ИначеЕсли СтрНачинаетсяС(НРег(Полный), НРег(КореньАбс)) Тогда
		Относительный = Сред(Полный, СтрДлина(КореньАбс) + 1);
		Относительный = СокрЛ(Относительный);
		Если СтрНачинаетсяС(Относительный, "\") Или СтрНачинаетсяС(Относительный, "/") Тогда
			Относительный = Сред(Относительный, 2);
		КонецЕсли;
	Иначе
		Относительный = Полный;
	КонецЕсли;
	Возврат СтрЗаменить(Относительный, "\", "/");
КонецФункции

Процедура ОбеспечитьКаталог(Путь) Экспорт
	Если Не ЗначениеЗаполнено(Путь) Тогда
		Возврат;
	КонецЕсли;
	Файл = Новый Файл(Путь);
	Если Файл.Существует() Тогда
		Возврат;
	КонецЕсли;
	Родитель = СокрП(Файл.Путь);
	Если ЗначениеЗаполнено(Родитель) И Родитель <> Путь Тогда
		ОбеспечитьКаталог(Родитель);
	КонецЕсли;
	СоздатьКаталог(Путь);
КонецПроцедуры

Процедура УдалитьДерево(Путь) Экспорт
	Если Не Существует(Путь) Тогда
		Возврат;
	КонецЕсли;
	Файл = Новый Файл(Путь);
	Если Файл.ЭтоКаталог() Тогда
		Найденные = НайтиФайлы(Путь, "*");
		Для Каждого Элемент Из Найденные Цикл
			УдалитьДерево(Элемент.ПолноеИмя);
		КонецЦикла;
	КонецЕсли;
	УдалитьФайлы(Путь);
КонецПроцедуры

Процедура КопироватьДерево(Источник, Приемник) Экспорт
	УдалитьДерево(Приемник);
	ФайлИст = Новый Файл(Источник);
	Если ФайлИст.ЭтоКаталог() Тогда
		ОбеспечитьКаталог(Приемник);
		Найденные = НайтиФайлы(Источник, "*");
		Для Каждого Элемент Из Найденные Цикл
			КопироватьДерево(Элемент.ПолноеИмя, ОбъединитьПути(Приемник, Элемент.Имя));
		КонецЦикла;
	Иначе
		ОбеспечитьКаталог(ФайлИст.Путь);
		ОбеспечитьКаталог(Новый Файл(Приемник).Путь);
		КопироватьФайл(Источник, Приемник);
	КонецЕсли;
КонецПроцедуры

Процедура КопироватьСодержимоеКаталога(Источник, Приемник) Экспорт
	ОбеспечитьКаталог(Приемник);
	Если Не КаталогСуществует(Источник) Тогда
		Возврат;
	КонецЕсли;
	Найденные = НайтиФайлы(Источник, "*");
	Для Каждого Элемент Из Найденные Цикл
		Цель = ОбъединитьПути(Приемник, Элемент.Имя);
		Если Элемент.ЭтоКаталог() Тогда
			КопироватьДерево(Элемент.ПолноеИмя, Цель);
		Иначе
			КопироватьФайл(Элемент.ПолноеИмя, Цель);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ПрочитатьТекст(Путь) Экспорт
	Если Не ФайлСуществует(Путь) Тогда
		Возврат "";
	КонецЕсли;
	Данные = Новый ДвоичныеДанные(Путь);
	Текст = ПолучитьСтрокуИзДвоичныхДанных(Данные, КодировкаТекста.UTF8);
	Если Текст = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если КодСимвола(Лев(Текст, 1)) = 65279 Тогда
		Текст = Сред(Текст, 2);
	КонецЕсли;
	Возврат Текст;
КонецФункции

Процедура ЗаписатьТекст(Путь, Текст) Экспорт
	ОбеспечитьКаталог(Новый Файл(Путь).Путь);
	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8NoBOM);
	Запись.Записать(Текст);
	Запись.Закрыть();
КонецПроцедуры

Функция СобратьФайлы(Корень, Маски = Неопределено, Рекурсивно = Истина) Экспорт
	Результат = Новый Массив;
	Если Не КаталогСуществует(Корень) Тогда
		Возврат Результат;
	КонецЕсли;
	Если Маски = Неопределено Тогда
		СобратьФайлыРекурсия(Корень, "*", Рекурсивно, Результат);
	Иначе
		Для Каждого Маска Из Маски Цикл
			СобратьФайлыРекурсия(Корень, Маска, Рекурсивно, Результат);
		КонецЦикла;
	КонецЕсли;
	Возврат СортироватьСтроки(Результат);
КонецФункции

Процедура СобратьФайлыРекурсия(Каталог, Маска, Рекурсивно, Результат)
	Найденные = НайтиФайлы(Каталог, Маска, Рекурсивно);
	Для Каждого Элемент Из Найденные Цикл
		Если Элемент.ЭтоФайл() Тогда
			Результат.Добавить(Элемент.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция СортироватьСтроки(Массив) Экспорт
	Список = Новый СписокЗначений;
	Для Каждого Элемент Из Массив Цикл
		Список.Добавить(Элемент, Элемент);
	КонецЦикла;
	Список.СортироватьПоЗначению();
	Результат = Новый Массив;
	Для Каждого Элемент Из Список Цикл
		Результат.Добавить(Элемент.Значение);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ПеременнаяСреды(Имя) Экспорт
	Значение = ПолучитьПеременнуюСреды(Имя);
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));
КонецФункции

Процедура УстановитьЕслиПусто(Имя, Значение) Экспорт
	Если Не ЗначениеЗаполнено(ПеременнаяСреды(Имя)) Тогда
		УстановитьПеременнуюСреды(Имя, Значение);
	КонецЕсли;
КонецПроцедуры

Процедура ЗагрузитьDotEnv(Путь) Экспорт
	Если Не ФайлСуществует(Путь) Тогда
		Возврат;
	КонецЕсли;
	Текст = ПрочитатьТекст(Путь);
	Для Каждого Сырая Из СтрРазделить(Текст, Символы.ПС, Ложь) Цикл
		Строка = СокрЛП(СтрЗаменить(Сырая, Символы.ВК, ""));
		Если Не ЗначениеЗаполнено(Строка) Или СтрНачинаетсяС(Строка, "#") Тогда
			Продолжить;
		КонецЕсли;
		Поз = СтрНайти(Строка, "=");
		Если Поз < 2 Тогда
			Продолжить;
		КонецЕсли;
		Имя = СокрЛП(Лев(Строка, Поз - 1));
		Значение = СокрЛП(Сред(Строка, Поз + 1));
		Если СтрДлина(Значение) >= 2 Тогда
			Если (СтрНачинаетсяС(Значение, """") И СтрЗаканчиваетсяНа(Значение, """"))
				Или (СтрНачинаетсяС(Значение, "'") И СтрЗаканчиваетсяНа(Значение, "'")) Тогда
				Значение = Сред(Значение, 2, СтрДлина(Значение) - 2);
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(Имя) Тогда
			УстановитьЕслиПусто(Имя, Значение);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ДомашнийКаталог() Экспорт
	Дом = ПеременнаяСреды("USERPROFILE");
	Если Не ЗначениеЗаполнено(Дом) Тогда
		Дом = ПеременнаяСреды("HOME");
	КонецЕсли;
	Возврат Дом;
КонецФункции

Функция НайтиВPath(Имя) Экспорт
	Путь = ПеременнаяСреды("PATH");
	Разделитель = ?(ЭтоWindows(), ";", ":");
	Для Каждого Каталог Из СтрРазделить(Путь, Разделитель, Ложь) Цикл
		Каталог = СокрЛП(Каталог);
		Если Не ЗначениеЗаполнено(Каталог) Тогда
			Продолжить;
		КонецЕсли;
		Кандидаты = Новый Массив;
		Кандидаты.Добавить(ОбъединитьПути(Каталог, Имя));
		Если ЭтоWindows() И Не СтрЗаканчиваетсяНа(НРег(Имя), ".exe") Тогда
			Кандидаты.Добавить(ОбъединитьПути(Каталог, Имя + ".exe"));
			Кандидаты.Добавить(ОбъединитьПути(Каталог, Имя + ".bat"));
			Кандидаты.Добавить(ОбъединитьПути(Каталог, Имя + ".cmd"));
		КонецЕсли;
		Для Каждого Кандидат Из Кандидаты Цикл
			Если ФайлСуществует(Кандидат) Тогда
				Возврат АбсолютныйПуть(Кандидат);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция ОбернутьВКавычки(Значение)
	Возврат """" + СтрЗаменить(Строка(Значение), """", """""") + """";
КонецФункции

Функция ЗапуститьПрограмму(ИсполняемыйФайл, Знач Аргументы = Неопределено, РабочийКаталог = "") Экспорт
	Если Аргументы = Неопределено Тогда
		Аргументы = Новый Массив;
	КонецЕсли;
	Части = Новый Массив;
	Части.Добавить(ОбернутьВКавычки(ИсполняемыйФайл));
	Для Каждого Арг Из Аргументы Цикл
		Части.Добавить(ОбернутьВКавычки(Арг));
	КонецЦикла;
	СтрокаЗапуска = СтрСоединить(Части, " ");
	Каталог = ?(ЗначениеЗаполнено(РабочийКаталог), РабочийКаталог, Неопределено);
	Процесс = СоздатьПроцесс(СтрокаЗапуска, Каталог, Истина, Истина, КодировкаТекста.UTF8);
	Процесс.Запустить();
	Пока Не Процесс.Завершен Цикл
		Приостановить(50);
	КонецЦикла;
	Вывод = "";
	Ошибки = "";
	Попытка
		Вывод = Процесс.ПотокВывода.Прочитать();
	Исключение
	КонецПопытки;
	Попытка
		Ошибки = Процесс.ПотокОшибок.Прочитать();
	Исключение
	КонецПопытки;
	Если Вывод = Неопределено Тогда
		Вывод = "";
	КонецЕсли;
	Если Ошибки = Неопределено Тогда
		Ошибки = "";
	КонецЕсли;
	Результат = Новый Структура;
	Результат.Вставить("Код", Процесс.КодВозврата);
	Результат.Вставить("Вывод", Вывод);
	Результат.Вставить("Ошибки", Ошибки);
	Возврат Результат;
КонецФункции
