// Запись agent-config.yaml стадии (MCP + limits + access).
// Провайдер: KBSHFF_PROVIDER_* из .env, иначе YAML-шаблон. После записи
// оркестратор вызывает kbshff config provider set (CLI — канон).

Функция Провайдер(БазовыйТекст) Экспорт
	Результат = Новый Структура;
	BaseUrl = Окружение.ПеременнаяСреды("KBSHFF_PROVIDER_BASE_URL");
	Если Не ЗначениеЗаполнено(BaseUrl) Тогда
		BaseUrl = YamlУтилиты.Скаляр(БазовыйТекст, "base_url", "https://api.openai.com/v1");
	КонецЕсли;
	Модель = Окружение.ПеременнаяСреды("KBSHFF_PROVIDER_MODEL");
	Если Не ЗначениеЗаполнено(Модель) Тогда
		Модель = YamlУтилиты.Скаляр(БазовыйТекст, "model", "gpt-4o");
	КонецЕсли;
	ApiKeyEnv = Окружение.ПеременнаяСреды("KBSHFF_PROVIDER_API_KEY_ENV");
	Если Не ЗначениеЗаполнено(ApiKeyEnv) Тогда
		ApiKeyEnv = YamlУтилиты.Скаляр(БазовыйТекст, "api_key_env", "OPENAI_API_KEY");
	КонецЕсли;
	TimeoutMs = YamlУтилиты.Скаляр(БазовыйТекст, "timeout_ms", "180000");
	Результат.Вставить("BaseUrl", BaseUrl);
	Результат.Вставить("Модель", Модель);
	Результат.Вставить("ApiKeyEnv", ApiKeyEnv);
	Результат.Вставить("TimeoutMs", TimeoutMs);
	Возврат Результат;
КонецФункции

Процедура Записать(Путь, БазовыйТекст, КаталогЛогов, CfRoot, CfIndexRoot, SntxConfig, Indexer, SntxCommand, SntxArgs, IncludeSearxng, BslLs, ИмяСтадии) Экспорт
	ПС = Символы.ПС;
	Пров = Провайдер(БазовыйТекст);
	BaseUrl = Пров.BaseUrl;
	Модель = Пров.Модель;
	ApiKeyEnv = Пров.ApiKeyEnv;
	TimeoutMs = Пров.TimeoutMs;
	MaxIter = YamlУтилиты.Скаляр(БазовыйТекст, "max_iterations", "80");
	MaxTokens = YamlУтилиты.Скаляр(БазовыйТекст, "max_tokens", "800000");
	MaxDur = YamlУтилиты.Скаляр(БазовыйТекст, "max_duration_sec", "2400");
	Если ИмяСтадии = "analyst" Или ИмяСтадии = "coder" Тогда
		Попытка
			Если Число(MaxTokens) < 800000 Тогда
				MaxTokens = "800000";
			КонецЕсли;
		Исключение
			MaxTokens = "800000";
		КонецПопытки;
		Попытка
			Если Число(MaxIter) < 100 Тогда
				MaxIter = "100";
			КонецЕсли;
		Исключение
			MaxIter = "100";
		КонецПопытки;
	КонецЕсли;
	CfS = Экран(СтрЗаменить(Окружение.АбсолютныйПуть(CfRoot), "\", "/"));
	CfIndexS = Экран(СтрЗаменить(Окружение.АбсолютныйПуть(CfIndexRoot), "\", "/"));
	LogS = Экран(СтрЗаменить(Окружение.АбсолютныйПуть(КаталогЛогов), "\", "/"));
	SntxS = Экран(СтрЗаменить(SntxConfig, "\", "/"));
	IdxS = Экран(СтрЗаменить(Indexer, "\", "/"));
	CmdS = Экран(СтрЗаменить(SntxCommand, "\", "/"));
	SntxSrc = Экран(СтрЗаменить(Окружение.ОбъединитьПуть(Окружение.РодительскийКаталог(SntxConfig), "src"), "\", "/"));
	ArgsYaml = ArgsВYaml(SntxArgs);
	ДопEnv = "";
	Для Каждого Ключ Из СтрРазделить("APPDATA,LOCALAPPDATA,USERPROFILE,USERNAME", ",", Ложь) Цикл
		Зн = Окружение.ПеременнаяСреды(Ключ);
		Если ЗначениеЗаполнено(Зн) Тогда
			ДопEnv = ДопEnv + ПС + "      " + Ключ + ": """ + Экран(СтрЗаменить(Зн, "\", "/")) + """";
		КонецЕсли;
	КонецЦикла;
	Для Каждого Ключ Из СтрРазделить("OPENAI_API_KEY,POLZA_API_KEY,DEEPSEEK_API_KEY", ",", Ложь) Цикл
		Зн = Окружение.ПеременнаяСреды(Ключ);
		Если ЗначениеЗаполнено(Зн) Тогда
			ДопEnv = ДопEnv + ПС + "      " + Ключ + ": """ + Экран(Зн) + """";
		КонецЕсли;
	КонецЦикла;
	Searx = "";
	Если IncludeSearxng Тогда
		Searx = ПС + "  - name: ""searxng""" + ПС
			+ "    transport: http" + ПС
			+ "    url: ""http://127.0.0.1:3000/mcp""" + ПС
			+ "    timeout_ms: 60000" + ПС;
	КонецЕсли;
	BslBlock = "";
	Если BslLs <> Неопределено Тогда
		NodeS = Экран(СтрЗаменить(Окружение.АбсолютныйПуть(BslLs.Node), "\", "/"));
		JsS = Экран(СтрЗаменить(Окружение.АбсолютныйПуть(BslLs.ServerJs), "\", "/"));
		JarS = Экран(СтрЗаменить(Окружение.АбсолютныйПуть(BslLs.Jar), "\", "/"));
		JavaEnv = "";
		Если ЗначениеЗаполнено(BslLs.JavaHome) И Окружение.КаталогСуществует(BslLs.JavaHome) Тогда
			JavaEnv = ПС + "      JAVA_HOME: """ + Экран(СтрЗаменить(Окружение.АбсолютныйПуть(BslLs.JavaHome), "\", "/")) + """";
		КонецЕсли;
		BslBlock = ПС + "  - name: ""bsl-language-server""" + ПС
			+ "    command: """ + NodeS + """" + ПС
			+ "    args: [""" + JsS + """]" + ПС
			+ "    env:" + ПС
			+ "      BSL_LS_JAR: """ + JarS + """" + JavaEnv + ПС
			+ "    timeout_ms: 180000" + ПС;
	КонецЕсли;
	Программы = Новый Массив;
	Для Каждого Имя Из СтрРазделить("rg,git", ",", Ложь) Цикл
		Найден = Окружение.НайтиВPath(Имя);
		Если ЗначениеЗаполнено(Найден) Тогда
			Программы.Добавить("      - name: " + Имя + ПС + "        executable: """ + Экран(СтрЗаменить(Найден, "\", "/")) + """");
		КонецЕсли;
	КонецЦикла;
	Если Программы.Количество() > 0 Тогда
		ProgramsBlock = "    programs:" + ПС + СтрСоединить(Программы, ПС);
	Иначе
		ProgramsBlock = "    programs: []";
	КонецЕсли;
	PythonPathLine = "";
	Если СтрНайти(НРег(SntxCommand), "python") > 0 Тогда
		PythonPathLine = ПС + "      PYTHONPATH: """ + SntxSrc + """";
	КонецЕсли;
	Строки = Новый Массив;
	Строки.Добавить("provider:");
	Строки.Добавить("  base_url: """ + Экран(BaseUrl) + """");
	Строки.Добавить("  model: """ + Экран(Модель) + """");
	Строки.Добавить("  api_key_env: """ + Экран(ApiKeyEnv) + """");
	Строки.Добавить("  timeout_ms: " + TimeoutMs);
	Строки.Добавить("  max_retries: 3");
	Строки.Добавить("  retry_base_delay_ms: 500");
	Строки.Добавить("");
	Строки.Добавить("mcp:");
	Строки.Добавить("  - name: ""sntx_sem""");
	Строки.Добавить("    command: """ + CmdS + """");
	Строки.Добавить("    args: " + ArgsYaml);
	Строки.Добавить("    env:");
	Строки.Добавить("      SNTX_SEM_CONFIG: """ + SntxS + """");
	Строки.Добавить("      SNTX_SEM_MCP_LOG_LEVEL: ""INFO""" + PythonPathLine + ДопEnv);
	Строки.Добавить("    timeout_ms: 60000");
	Строки.Добавить("");
	Строки.Добавить("  - name: ""code-index""");
	Строки.Добавить("    command: """ + IdxS + """");
	Строки.Добавить("    args: [""serve"", ""--path"", ""cf=" + CfIndexS + """]");
	Строки.Добавить("    timeout_ms: 60000");
	Строки.Добавить("");
	Текст = СтрСоединить(Строки, ПС) + BslBlock + Searx;
	Если Не СтрЗаканчиваетсяНа(Текст, ПС) Тогда
		Текст = Текст + ПС;
	КонецЕсли;
	Текст = Текст + ПС;
	Строки2 = Новый Массив;
	Строки2.Добавить("limits:");
	Строки2.Добавить("  max_iterations: " + MaxIter);
	Строки2.Добавить("  max_tokens: " + MaxTokens);
	Строки2.Добавить("  max_duration_sec: " + MaxDur);
	Строки2.Добавить("");
	Строки2.Добавить("logging:");
	Строки2.Добавить("  enable_ai_log: true");
	Строки2.Добавить("  enable_mcp_log: true");
	Строки2.Добавить("  enable_chat_history: true");
	Строки2.Добавить("  output_dir: """ + LogS + """");
	Строки2.Добавить("");
	Строки2.Добавить("access:");
	Строки2.Добавить("  mode: strict");
	Строки2.Добавить("  tools:");
	Строки2.Добавить("    builtins:");
	Строки2.Добавить("      - home.list");
	Строки2.Добавить("      - home.read");
	Строки2.Добавить("      - home.write");
	Строки2.Добавить("      - home.run");
	Строки2.Добавить("      - local_tools.search_docs");
	Строки2.Добавить("      - local_tools.read_file");
	Строки2.Добавить("  filesystem:");
	Строки2.Добавить("    home:");
	Строки2.Добавить("      read: ["".""]");
	Строки2.Добавить("      write: [""out/"", ""notes/""]");
	Строки2.Добавить("    workspace:");
	Строки2.Добавить("      root: """ + CfS + """");
	Строки2.Добавить("      read: ["".""]");
	Строки2.Добавить("    input_roots:");
	Строки2.Добавить("      - "".""");
	Строки2.Добавить("  run:");
	Строки2.Добавить(ProgramsBlock);
	Окружение.ЗаписатьТекст(Путь, Текст + СтрСоединить(Строки2, ПС) + ПС);
КонецПроцедуры

Функция Экран(Текст)
	Возврат СтрЗаменить(СтрЗаменить(Строка(Текст), "\", "\\"), """", "\""");
КонецФункции

Функция ArgsВYaml(Аргументы)
	Части = Новый Массив;
	Для Каждого Арг Из Аргументы Цикл
		Части.Добавить("""" + Экран(Арг) + """");
	КонецЦикла;
	Возврат "[" + СтрСоединить(Части, ", ") + "]";
КонецФункции
