// UUID v5 (SHA1, namespace URL) — как uuid.uuid5 в Python.

Функция ИзИмени(Имя) Экспорт
	Нс = Новый БуферДвоичныхДанных(16);
	Гекс = "6ba7b8119dad11d180b400c04fd430c8";
	Для Инд = 0 По 15 Цикл
		Нс[Инд] = БайтИзГекс(Сред(Гекс, Инд * 2 + 1, 2));
	КонецЦикла;
	Хеш = Новый ХешированиеДанных(ХешФункция.SHA1);
	Хеш.Добавить(ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Нс));
	Хеш.Добавить(ПолучитьДвоичныеДанныеИзСтроки(Имя, КодировкаТекста.UTF8));
	Сумма = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Хеш.ХешСумма);
	Сумма[6] = (Сумма[6] % 16) + 80;
	Сумма[8] = (Сумма[8] % 64) + 128;
	ГексИтог = НРег(ПолучитьHexСтрокуИзБуфераДвоичныхДанных(Сумма));
	Возврат Сред(ГексИтог, 1, 8) + "-" + Сред(ГексИтог, 9, 4) + "-" + Сред(ГексИтог, 13, 4)
		+ "-" + Сред(ГексИтог, 17, 4) + "-" + Сред(ГексИтог, 21, 12);
КонецФункции

Функция ЦифраГекс(Символ)
	Карта = "0123456789abcdef";
	Поз = СтрНайти(Карта, НРег(Символ));
	Если Поз = 0 Тогда
		ВызватьИсключение "неверная hex-цифра: " + Символ;
	КонецЕсли;
	Возврат Поз - 1;
КонецФункции

Функция БайтИзГекс(ДваСимвола)
	Возврат ЦифраГекс(Сред(ДваСимвола, 1, 1)) * 16 + ЦифраГекс(Сред(ДваСимвола, 2, 1));
КонецФункции
