// Скоринг артефактов стадии (schema + needles).

Функция ОценитьЗадачу(Ожидание, ДомаСтадий, ВыводыСтадий, CfНеИзменён) Экспорт
	Ошибки = Новый Массив;
	Если Не CfНеИзменён Тогда
		Ошибки.Добавить("CF dump was modified by the agent");
	КонецЕсли;
	Для Каждого КлючЗначение Из ВыводыСтадий Цикл
		Стоп = Строка(JsonУтилиты.ПолучитьПоле(КлючЗначение.Значение, "stop_reason", ""));
		Если Стоп <> "goal_reached" Тогда
			Ошибки.Добавить(КлючЗначение.Ключ + ": agent_stop='" + Стоп
				+ "' (loop did not finish; goal_reached ≠ contract pass)");
		КонецЕсли;
	КонецЦикла;
	ДомAnalyst = ДомаСтадий.Получить("analyst");
	ДомYax = ДомаСтадий.Получить("yaxunit");
	ДомCoder = ДомаСтадий.Получить("coder");
	ДомImpl = ДомаСтадий.Получить("implementer");
	Если ДомAnalyst <> Неопределено Тогда
		ОценитьAnalyst(Ожидание, ДомAnalyst, Ошибки);
	КонецЕсли;
	Если ДомYax <> Неопределено Тогда
		ОценитьYaxunit(Ожидание, ДомYax, Ошибки);
	КонецЕсли;
	Если ДомCoder <> Неопределено Тогда
		ОценитьCoder(Ожидание, ДомCoder, Ошибки);
	КонецЕсли;
	Если ДомImpl <> Неопределено Тогда
		ОценитьImplementer(Ожидание, ДомImpl, Ошибки);
	КонецЕсли;
	Результат = Новый Структура("Ок,Ошибки", Ошибки.Количество() = 0, Ошибки);
	Возврат Результат;
КонецФункции

Процедура ОценитьAnalyst(Ожидание, Дом, Ошибки)
	Выход = Окружение.ОбъединитьПуть(Дом, "out");
	Для Каждого Имя Из МассивПоля(Ожидание, "plan_files") Цикл
		Если Не Окружение.ФайлСуществует(Окружение.ОбъединитьПуть(Выход, Строка(Имя))) Тогда
			Ошибки.Добавить("analyst missing out/" + Строка(Имя));
		КонецЕсли;
	КонецЦикла;
	Если Не Окружение.ФайлСуществует(Окружение.ОбъединитьПуть(Выход, "agreements.md")) Тогда
		Ошибки.Добавить("analyst missing out/agreements.md");
	КонецЕсли;
	ТекстДог = Окружение.ПрочитатьТекст(Окружение.ОбъединитьПуть(Выход, "agreements.md"));
	Для Каждого Игла Из Отсутствующие(ТекстДог, ИглыДоговорённостей(Ожидание)) Цикл
		Ошибки.Добавить("analyst agreements.md missing '" + Игла + "'");
	КонецЦикла;
	ТекстПлана = СобратьТексты(Выход, МассивСтрок("*.md", "*.json"));
	Для Каждого Игла Из Отсутствующие(ТекстПлана, МассивПоля(Ожидание, "plan_contains")) Цикл
		Ошибки.Добавить("analyst plan missing '" + Игла + "'");
	КонецЦикла;
	ПроверитьРежим(Выход, "none", "analyst", Ошибки);
КонецПроцедуры

Процедура ОценитьYaxunit(Ожидание, Дом, Ошибки)
	Выход = Окружение.ОбъединитьПуть(Дом, "out");
	Если Не Окружение.ФайлСуществует(Окружение.ОбъединитьПуть(Выход, "test-report.md")) Тогда
		Ошибки.Добавить("yaxunit missing out/test-report.md");
	КонецЕсли;
	Тесты = Окружение.ОбъединитьПуть(Выход, "tests");
	CfeТесты = Окружение.ОбъединитьПуть(Выход, "cfe-tests");
	BslТесты = Окружение.СобратьФайлы(Тесты, МассивСтрок("*.bsl"));
	BslCfe = Окружение.СобратьФайлы(CfeТесты, МассивСтрок("*.bsl"));
	Если BslТесты.Количество() = 0 И BslCfe.Количество() = 0 Тогда
		Ошибки.Добавить("yaxunit missing BSL under out/tests or out/cfe-tests");
	КонецЕсли;
	Текст = СобратьТексты(Тесты, МассивСтрок("*.bsl")) + Символы.ПС + СобратьТексты(CfeТесты, МассивСтрок("*.bsl"));
	Для Каждого Игла Из Отсутствующие(Текст, МассивПоля(Ожидание, "test_contains")) Цикл
		Ошибки.Добавить("yaxunit tests missing '" + Игла + "'");
	КонецЦикла;
	Yax = JsonУтилиты.ПолучитьПоле(Ожидание, "yaxunit");
	ПроцедураИмя = JsonУтилиты.ПолучитьПоле(Yax, "procedure");
	Если ЗначениеЗаполнено(ПроцедураИмя) И СтрНайти(Текст, Строка(ПроцедураИмя)) = 0 Тогда
		Ошибки.Добавить("yaxunit tests missing procedure '" + ПроцедураИмя + "'");
	КонецЕсли;
	Если ЗначениеЗаполнено(СокрЛП(Текст)) И СтрНайти(Текст, "ЮТТесты") = 0 И СтрНайти(Текст, "ЮТест") = 0 Тогда
		Ошибки.Добавить("yaxunit BSL missing ЮТТесты/ЮТест");
	КонецЕсли;
	ПроверитьРежим(Выход, "none", "yaxunit", Ошибки);
КонецПроцедуры

Процедура ОценитьCoder(Ожидание, Дом, Ошибки)
	Выход = Окружение.ОбъединитьПуть(Дом, "out");
	Src = Окружение.ОбъединитьПуть(Выход, "src");
	ФайлыSrc = Окружение.СобратьФайлы(Src);
	Если Не Окружение.КаталогСуществует(Src) Или ФайлыSrc.Количество() = 0 Тогда
		Ошибки.Добавить("coder out/src is empty");
	КонецЕсли;
	Если Не Окружение.ФайлСуществует(Окружение.ОбъединитьПуть(Выход, "code-report.md")) Тогда
		Ошибки.Добавить("coder missing code-report.md");
	КонецЕсли;
	Текст = СобратьТексты(Src, Неопределено);
	Для Каждого Игла Из Отсутствующие(Текст, МассивПоля(Ожидание, "src_contains")) Цикл
		Ошибки.Добавить("coder src missing '" + Игла + "'");
	КонецЦикла;
	Любые = МассивПоля(Ожидание, "src_contains_any");
	Если Любые.Количество() > 0 И Не СодержитЛюбой(Текст, Любые) Тогда
		Ошибки.Добавить("coder src missing any of '" + СтрСоединить(Любые, ",") + "'");
	КонецЕсли;
	ПроверитьРежим(Выход, "none", "coder", Ошибки);
КонецПроцедуры

Процедура ОценитьImplementer(Ожидание, Дом, Ошибки)
	Выход = Окружение.ОбъединитьПуть(Дом, "out");
	Cfe = Окружение.ОбъединитьПуть(Выход, "cfe");
	Если Не Окружение.ФайлСуществует(Окружение.ОбъединитьПуть(Cfe, "Configuration.xml")) Тогда
		Конфиги = Окружение.СобратьФайлы(Cfe, МассивСтрок("Configuration.xml"));
		Если Конфиги.Количество() = 0 Тогда
			Ошибки.Добавить("implementer missing out/cfe/Configuration.xml");
		КонецЕсли;
	КонецЕсли;
	ТекстCfe = СобратьТексты(Cfe, Неопределено);
	ВсеФайлы = Окружение.СобратьФайлы(Cfe);
	Для Каждого Объект Из МассивПоля(Ожидание, "cfe_objects") Цикл
		Игла = СтрЗаменить(Строка(Объект), "\", "/");
		Части = СтрРазделить(Игла, "/", Ложь);
		Лист = Части[Части.ВГраница()];
		Если СтрНайти(ТекстCfe, Игла) = 0 И СтрНайти(ТекстCfe, Лист) = 0 Тогда
			Если Не ЕстьФайлСИменем(ВсеФайлы, Лист) Тогда
				Ошибки.Добавить("implementer CFE missing object '" + Объект + "'");
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Игла Из Отсутствующие(ТекстCfe, МассивПоля(Ожидание, "cfe_contains")) Цикл
		Ошибки.Добавить("implementer CFE missing '" + Игла + "'");
	КонецЦикла;
	Любые = МассивПоля(Ожидание, "cfe_contains_any");
	Если Любые.Количество() > 0 И Не СодержитЛюбой(ТекстCfe, Любые) Тогда
		Ошибки.Добавить("implementer CFE missing any of '" + СтрСоединить(Любые, ",") + "'");
	КонецЕсли;
	ПроверитьРежим(Выход, "copy_out", "implementer", Ошибки);
	Если Не Окружение.ФайлСуществует(Окружение.ОбъединитьПуть(Выход, "implement-report.md"))
		И Не Окружение.ФайлСуществует(Окружение.ОбъединитьПуть(Выход, "checklist.md")) Тогда
		Ошибки.Добавить("implementer missing implement-report.md/checklist.md");
	КонецЕсли;
КонецПроцедуры

Функция ЕстьФайлСИменем(Файлы, Лист)
	СуффиксXml = "/" + Лист + ".xml";
	Суффикс = "/" + Лист;
	Для Каждого Путь Из Файлы Цикл
		Позикс = СтрЗаменить(Путь, "\", "/");
		Если СтрЗаканчиваетсяНа(Позикс, Суффикс) Или СтрЗаканчиваетсяНа(Позикс, СуффиксXml) Тогда
			Возврат Истина;
		КонецЕсли;
		Если Окружение.ИмяФайла(Путь) = Лист Или Окружение.ИмяФайла(Путь) = Лист + ".xml" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Процедура ПроверитьРежим(Выход, Ожидаемый, Стадия, Ошибки)
	Режим = РежимМанифеста(Выход);
	Если Режим <> Неопределено И Режим <> Ожидаемый Тогда
		Ошибки.Добавить(Стадия + " manifest.apply_mode='" + Режим + "' expected '" + Ожидаемый + "'");
	КонецЕсли;
КонецПроцедуры

Функция РежимМанифеста(КаталогВыхода)
	Путь = Окружение.ОбъединитьПуть(КаталогВыхода, "manifest.json");
	Если Не Окружение.ФайлСуществует(Путь) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Данные = JsonУтилиты.ПрочитатьФайлJSON(Путь);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Режим = JsonУтилиты.ПолучитьПоле(Данные, "apply_mode");
	Если Режим = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Строка(Режим);
КонецФункции

Функция ИглыДоговорённостей(Ожидание)
	Иглы = Новый Массив;
	ДобавитьИглы(Иглы, МассивПоля(Ожидание, "plan_contains"));
	ДобавитьИглы(Иглы, МассивПоля(Ожидание, "test_contains"));
	ПроцедураИмя = JsonУтилиты.ПолучитьПоле(JsonУтилиты.ПолучитьПоле(Ожидание, "yaxunit"), "procedure");
	Если ЗначениеЗаполнено(ПроцедураИмя) Тогда
		Иглы.Добавить(Строка(ПроцедураИмя));
	КонецЕсли;
	Возврат Уникальные(Иглы);
КонецФункции

Процедура ДобавитьИглы(Приёмник, Источник)
	Для Каждого Элемент Из Источник Цикл
		Текст = Строка(Элемент);
		Если ЗначениеЗаполнено(Текст) Тогда
			Приёмник.Добавить(Текст);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция Уникальные(Массив)
	Виденные = Новый Соответствие;
	Результат = Новый Массив;
	Для Каждого Элемент Из Массив Цикл
		Если Виденные.Получить(Элемент) = Истина Тогда
			Продолжить;
		КонецЕсли;
		Виденные.Вставить(Элемент, Истина);
		Результат.Добавить(Элемент);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция Отсутствующие(Сен, Иглы)
	Нет = Новый Массив;
	Для Каждого Игла Из Иглы Цикл
		Если ЗначениеЗаполнено(Игла) И СтрНайти(Сен, Игла) = 0 Тогда
			Нет.Добавить(Игла);
		КонецЕсли;
	КонецЦикла;
	Возврат Нет;
КонецФункции

Функция СодержитЛюбой(Сен, Иглы)
	Если Иглы.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Для Каждого Игла Из Иглы Цикл
		Если ЗначениеЗаполнено(Игла) И СтрНайти(Сен, Игла) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция СобратьТексты(Корень, Маски)
	Если Не Окружение.КаталогСуществует(Корень) Тогда
		Возврат "";
	КонецЕсли;
	Если Маски = Неопределено Тогда
		Маски = МассивСтрок("*.bsl", "*.xml", "*.md", "*.json");
	КонецЕсли;
	Куски = Новый Массив;
	Для Каждого Путь Из Окружение.СобратьФайлы(Корень, Маски) Цикл
		Куски.Добавить(Окружение.ПрочитатьТекст(Путь));
	КонецЦикла;
	Возврат СтрСоединить(Куски, Символы.ПС);
КонецФункции

Функция МассивПоля(Объект, Ключ)
	Значение = JsonУтилиты.ПолучитьПоле(Объект, Ключ);
	Если Значение = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Если JsonУтилиты.ЭтоМассив(Значение) Тогда
		Возврат Значение;
	КонецЕсли;
	Результат = Новый Массив;
	Результат.Добавить(Значение);
	Возврат Результат;
КонецФункции

Функция МассивСтрок(А, Б = Неопределено, В = Неопределено, Г = Неопределено)
	Результат = Новый Массив;
	Результат.Добавить(А);
	Если Б <> Неопределено Тогда
		Результат.Добавить(Б);
	КонецЕсли;
	Если В <> Неопределено Тогда
		Результат.Добавить(В);
	КонецЕсли;
	Если Г <> Неопределено Тогда
		Результат.Добавить(Г);
	КонецЕсли;
	Возврат Результат;
КонецФункции
