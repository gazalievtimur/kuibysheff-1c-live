// Проверка report.json: все задачи pass.

Функция Проверить(ПутьОтчёта) Экспорт
	Если Не Окружение.ФайлСуществует(ПутьОтчёта) Тогда
		Сообщить("missing report.json: " + ПутьОтчёта);
		Возврат 1;
	КонецЕсли;
	Попытка
		Отчёт = JsonУтилиты.ПрочитатьФайлJSON(ПутьОтчёта);
	Исключение
		Сообщить("failed to read report.json: " + ОписаниеОшибки());
		Возврат 1;
	КонецПопытки;
	Если Не JsonУтилиты.ЭтоСоответствие(Отчёт) Тогда
		Сообщить("report.json root must be an object");
		Возврат 1;
	КонецЕсли;
	НапечататьСводку(ПутьОтчёта, Отчёт);
	Задачи = JsonУтилиты.ПолучитьПоле(Отчёт, "tasks");
	Если Не JsonУтилиты.ЭтоМассив(Задачи) Или Задачи.Количество() = 0 Тогда
		Сообщить("1c-live regression FAILED: no tasks in report");
		Возврат 1;
	КонецЕсли;
	Проваленные = Новый Массив;
	Для Каждого Строка Из Задачи Цикл
		Если JsonУтилиты.ЭтоСоответствие(Строка) И Строка.Получить("pass") <> Истина Тогда
			Проваленные.Добавить(Строка(JsonУтилиты.ПолучитьПоле(Строка, "id")));
		КонецЕсли;
	КонецЦикла;
	Если Проваленные.Количество() > 0 Тогда
		Сообщить("1c-live regression FAILED: " + Строка(Проваленные.Количество()) + " task(s): " + СтрСоединить(Проваленные, ", "));
		Возврат 1;
	КонецЕсли;
	Failed = JsonУтилиты.ПолучитьПоле(Отчёт, "failed");
	Если Failed <> Неопределено И Число(Failed) <> 0 Тогда
		Сообщить("1c-live regression FAILED: report.failed=" + Строка(Failed));
		Возврат 1;
	КонецЕсли;
	Сообщить("1c-live regression PASSED.");
	Возврат 0;
КонецФункции

Процедура НапечататьСводку(ПутьОтчёта, Отчёт)
	Сообщить("report: " + ПутьОтчёта);
	Сообщить("run_id: " + Строка(JsonУтилиты.ПолучитьПоле(Отчёт, "run_id")));
	Сообщить("totals: passed=" + Строка(JsonУтилиты.ПолучитьПоле(Отчёт, "passed"))
		+ " failed=" + Строка(JsonУтилиты.ПолучитьПоле(Отчёт, "failed"))
		+ " total=" + Строка(JsonУтилиты.ПолучитьПоле(Отчёт, "total")));
	Задачи = JsonУтилиты.ПолучитьПоле(Отчёт, "tasks");
	Если Не JsonУтилиты.ЭтоМассив(Задачи) Тогда
		Сообщить("tasks: <missing>");
		Возврат;
	КонецЕсли;
	Для Каждого Строка Из Задачи Цикл
		Если Не JsonУтилиты.ЭтоСоответствие(Строка) Тогда
			Продолжить;
		КонецЕсли;
		Coder = JsonУтилиты.ПолучитьПоле(JsonУтилиты.ПолучитьПоле(Строка, "stages"), "coder");
		Usage = JsonУтилиты.ПолучитьПоле(Coder, "usage");
		Сообщить("  - " + Строка(JsonУтилиты.ПолучитьПоле(Строка, "id"))
			+ ": pass=" + Строка(JsonУтилиты.ПолучитьПоле(Строка, "pass"))
			+ " yaxunit='" + Строка(JsonУтилиты.ПолучитьПоле(Строка, "yaxunit")) + "'"
			+ " usage=" + СтрокаUsage(Usage));
		Если JsonУтилиты.ПолучитьПоле(Строка, "failures") <> Неопределено Тогда
			Сообщить("      failures: " + JsonУтилиты.ВJSON(JsonУтилиты.ПолучитьПоле(Строка, "failures")));
		КонецЕсли;
		Если JsonУтилиты.ПолучитьПоле(Строка, "error") <> Неопределено Тогда
			Сообщить("      error: " + Строка(JsonУтилиты.ПолучитьПоле(Строка, "error")));
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция СтрокаUsage(Usage)
	Если Не JsonУтилиты.ЭтоСоответствие(Usage) Тогда
		Возврат "n/a";
	КонецЕсли;
	Части = Новый Массив;
	Для Каждого Ключ Из СтрРазделить("iterations,prompt_tokens,completion_tokens,total_tokens", ",", Ложь) Цикл
		Зн = JsonУтилиты.ПолучитьПоле(Usage, Ключ);
		Если Зн <> Неопределено Тогда
			Части.Добавить(Ключ + "=" + Строка(Зн));
		КонецЕсли;
	КонецЦикла;
	Если Части.Количество() = 0 Тогда
		Возврат "n/a";
	КонецЕсли;
	Возврат СтрСоединить(Части, ", ");
КонецФункции
