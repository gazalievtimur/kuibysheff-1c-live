// Поиск / сборка kbshff: KBSHFF_BIN, PATH, KUIBYSHEFF_SRC, соседний checkout.

Функция НайтиБинарник(КореньРепо, ЯвныйПуть = "", Собирать = Ложь) Экспорт
	Если ЗначениеЗаполнено(ЯвныйПуть) Тогда
		Путь = Окружение.АбсолютныйПуть(ЯвныйПуть);
		Если Не Окружение.ФайлСуществует(Путь) Тогда
			ВызватьИсключение "kbshff binary not found: " + Путь;
		КонецЕсли;
		Возврат Путь;
	КонецЕсли;
	EnvBin = Окружение.ПеременнаяСреды("KBSHFF_BIN");
	Если ЗначениеЗаполнено(EnvBin) Тогда
		Путь = Окружение.АбсолютныйПуть(EnvBin);
		Если Не Окружение.ФайлСуществует(Путь) Тогда
			ВызватьИсключение "KBSHFF_BIN not found: " + Путь;
		КонецЕсли;
		Возврат Путь;
	КонецЕсли;
	Если Не Собирать Тогда
		ИзPath = Окружение.НайтиВPath("kbshff");
		Если ЗначениеЗаполнено(ИзPath) Тогда
			Возврат ИзPath;
		КонецЕсли;
	КонецЕсли;
	Src = НайтиИсходники(КореньРепо);
	Если Не ЗначениеЗаполнено(Src) Тогда
		ВызватьИсключение "kbshff not found. Install a release binary and ensure it is on PATH, or set one of: KBSHFF_BIN, KUIBYSHEFF_SRC. See https://github.com/gazalievtimur/Agent-Kuibysheff";
	КонецЕсли;
	Сообщить("Building kbshff from " + Src + " ...");
	Cargo = Окружение.НайтиВPath("cargo");
	Если Не ЗначениеЗаполнено(Cargo) Тогда
		ВызватьИсключение "cargo not found on PATH (needed to build kbshff)";
	КонецЕсли;
	Аргументы = Новый Массив;
	Аргументы.Добавить("build");
	Аргументы.Добавить("--release");
	Аргументы.Добавить("-p");
	Аргументы.Добавить("agent_Kuibysheff");
	Аргументы.Добавить("--bin");
	Аргументы.Добавить("kbshff");
	Запуск = Окружение.ЗапуститьПрограмму(Cargo, Аргументы, Src);
	Если Запуск.Код <> 0 Тогда
		ВызватьИсключение "cargo build failed: " + Запуск.Ошибки + Запуск.Вывод;
	КонецЕсли;
	Собранный = РелизныйБинарник(Src);
	Если Не ЗначениеЗаполнено(Собранный) Тогда
		ВызватьИсключение "cargo build succeeded but target/release/kbshff was not found under " + Src;
	КонецЕсли;
	Возврат Собранный;
КонецФункции

Функция НайтиИсходники(КореньРепо)
	EnvSrc = Окружение.ПеременнаяСреды("KUIBYSHEFF_SRC");
	Если ЗначениеЗаполнено(EnvSrc) И Окружение.ФайлСуществует(Окружение.ОбъединитьПуть(EnvSrc, "Cargo.toml")) Тогда
		Возврат Окружение.АбсолютныйПуть(EnvSrc);
	КонецЕсли;
	Родитель = Окружение.РодительскийКаталог(КореньРепо);
	Соседи = Новый Массив;
	Соседи.Добавить("Agent-Kuibysheff");
	Соседи.Добавить("Agent Kuibyshev");
	Для Каждого Имя Из Соседи Цикл
		Кандидат = Окружение.ОбъединитьПуть(Родитель, Имя);
		Если Окружение.ФайлСуществует(Окружение.ОбъединитьПуть(Кандидат, "Cargo.toml")) Тогда
			Возврат Окружение.АбсолютныйПуть(Кандидат);
		КонецЕсли;
	КонецЦикла;
	Если Окружение.ФайлСуществует(Окружение.ОбъединитьПуть(КореньРепо, "Cargo.toml")) Тогда
		Возврат Окружение.АбсолютныйПуть(КореньРепо);
	КонецЕсли;
	Возврат "";
КонецФункции

Функция РелизныйБинарник(Src)
	Кандидаты = Новый Массив;
	Кандидаты.Добавить(Окружение.ОбъединитьПуть(Src, "target", "release", "kbshff.exe"));
	Кандидаты.Добавить(Окружение.ОбъединитьПуть(Src, "target", "release", "kbshff"));
	Для Каждого Кандидат Из Кандидаты Цикл
		Если Окружение.ФайлСуществует(Кандидат) Тогда
			Возврат Окружение.АбсолютныйПуть(Кандидат);
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции
