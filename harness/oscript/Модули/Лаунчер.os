// Точка входа: dotenv, kbshff, eval, assert.

Функция Главная(Знач Аргументы, КореньРепо) Экспорт
	КореньРепо = Окружение.АбсолютныйПуть(КореньРепо);
	Окружение.УстановитьЕслиПусто("KUIBYSHEFF_ALLOW_UNSANDBOXED_MCP", "1");
	Окружение.ЗагрузитьDotEnv(Окружение.ОбъединитьПуть(КореньРепо, ".env"));
	Параметры = АргументыЗапуска.РазобратьEval(Аргументы);
	Если ЗначениеЗаполнено(Параметры.RepoRoot) Тогда
		КореньРепо = Окружение.АбсолютныйПуть(Параметры.RepoRoot);
	КонецЕсли;
	КаталогHarness = Окружение.ОбъединитьПуть(КореньРепо, "harness");
	Если Параметры.DryRun Тогда
		Код = Конвейер.Главная(Аргументы, КаталогHarness);
		Если Код = 0 Тогда
			Сообщить("1c-live dry-run OK.");
		КонецЕсли;
		Возврат Код;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Параметры.AgentBin) Тогда
		Параметры.AgentBin = РазрешениеKbshff.НайтиБинарник(КореньРепо, "", Не Параметры.SkipBuild);
		Аргументы = ДобавитьФлаг(Аргументы, "--agent-bin", Параметры.AgentBin);
	КонецЕсли;
	Сообщить("Using kbshff: " + Параметры.AgentBin);
	Сообщить("Running 1c-live eval...");
	Код = Конвейер.Главная(Аргументы, КаталогHarness);
	Если Код <> 0 Тогда
		Возврат Код;
	КонецЕсли;
	Latest = СокрЛП(СтрЗаменить(Окружение.ПрочитатьТекст(Окружение.ОбъединитьПуть(КаталогHarness, "runs", "LATEST")), Символы.ВК, ""));
	Если Не ЗначениеЗаполнено(Latest) Тогда
		ВызватьИсключение "No runs/LATEST after eval";
	КонецЕсли;
	Возврат ПроверкаРегрессии.Проверить(Окружение.ОбъединитьПуть(Latest, "report.json"));
КонецФункции

Функция ДобавитьФлаг(Аргументы, Имя, Значение)
	Есть = Ложь;
	Для Каждого Арг Из Аргументы Цикл
		Если Арг = Имя Тогда
			Есть = Истина;
		КонецЕсли;
	КонецЦикла;
	Если Есть Тогда
		Возврат Аргументы;
	КонецЕсли;
	Копия = Новый Массив;
	Для Каждого Арг Из Аргументы Цикл
		Копия.Добавить(Арг);
	КонецЦикла;
	Копия.Добавить(Имя);
	Копия.Добавить(Значение);
	Возврат Копия;
КонецФункции
