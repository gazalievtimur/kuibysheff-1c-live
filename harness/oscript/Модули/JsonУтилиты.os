// JSON: файлы, строки, извлечение объекта из stdout агента.

Функция ПрочитатьСтрокуJSON(Текст) Экспорт
	Если Не ЗначениеЗаполнено(СокрЛП(Текст)) Тогда
		ВызватьИсключение "empty JSON";
	КонецЕсли;
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Данные;
КонецФункции

Функция ПрочитатьФайлJSON(Путь) Экспорт
	Возврат ПрочитатьСтрокуJSON(Окружение.ПрочитатьТекст(Путь));
КонецФункции

Функция ВJSON(Значение) Экспорт
	ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Unix, "  ");
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(ПараметрыЗаписи);
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();
КонецФункции

Процедура ЗаписатьФайлJSON(Путь, Значение) Экспорт
	Окружение.ЗаписатьТекст(Путь, ВJSON(Значение) + Символы.ПС);
КонецПроцедуры

Функция ИзвлечьОбъектJSON(Текст) Экспорт
	Старт = СтрНайти(Текст, "{");
	Если Старт = 0 Тогда
		ВызватьИсключение "no JSON object in agent stdout";
	КонецЕсли;
	Глубина = 0;
	Конец = 0;
	Для Инд = Старт По СтрДлина(Текст) Цикл
		Симв = Сред(Текст, Инд, 1);
		Если Симв = "{" Тогда
			Глубина = Глубина + 1;
		ИначеЕсли Симв = "}" Тогда
			Глубина = Глубина - 1;
			Если Глубина = 0 Тогда
				Конец = Инд;
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если Конец < Старт Тогда
		ВызватьИсключение "unterminated JSON object in agent stdout";
	КонецЕсли;
	Возврат ПрочитатьСтрокуJSON(Сред(Текст, Старт, Конец - Старт + 1));
КонецФункции

Функция ПолучитьПоле(Объект, Ключ, ПоУмолчанию = Неопределено) Экспорт
	Если Объект = Неопределено Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Если ТипЗнч(Объект) = Тип("Соответствие") Тогда
		Значение = Объект.Получить(Ключ);
		Если Значение = Неопределено Тогда
			Возврат ПоУмолчанию;
		КонецЕсли;
		Возврат Значение;
	КонецЕсли;
	Если ТипЗнч(Объект) = Тип("Структура") Тогда
		Если Объект.Свойство(Ключ) Тогда
			Возврат Объект[Ключ];
		КонецЕсли;
		Возврат ПоУмолчанию;
	КонецЕсли;
	Возврат ПоУмолчанию;
КонецФункции

Функция ЭтоСоответствие(Значение) Экспорт
	Возврат ТипЗнч(Значение) = Тип("Соответствие") Или ТипЗнч(Значение) = Тип("Структура");
КонецФункции

Функция ЭтоМассив(Значение) Экспорт
	Возврат ТипЗнч(Значение) = Тип("Массив");
КонецФункции
