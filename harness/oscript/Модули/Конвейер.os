// Четырёхстадийный live-eval: analyst → yaxunit → coder → implementer.

Функция Главная(Знач Аргументы, Знач КаталогHarness) Экспорт
	КаталогHarness = Окружение.АбсолютныйПуть(КаталогHarness);
	Параметры = АргументыЗапуска.РазобратьEval(Аргументы);
	КореньРепо = ?(ЗначениеЗаполнено(Параметры.RepoRoot), Окружение.АбсолютныйПуть(Параметры.RepoRoot), Окружение.РодительскийКаталог(КаталогHarness));
	Окружение.ЗагрузитьDotEnv(Окружение.ОбъединитьПуть(КореньРепо, ".env"));
	BankDir = ?(ЗначениеЗаполнено(Параметры.BankDir), Окружение.АбсолютныйПуть(Параметры.BankDir), Окружение.ОбъединитьПуть(КаталогHarness, "bank"));
	CfDir = ?(ЗначениеЗаполнено(Параметры.CfDir), Окружение.АбсолютныйПуть(Параметры.CfDir), Окружение.ОбъединитьПуть(КаталогHarness, "cf"));
	YaxDir = ?(ЗначениеЗаполнено(Параметры.YaxunitDir), Окружение.АбсолютныйПуть(Параметры.YaxunitDir), Окружение.ОбъединитьПуть(КаталогHarness, "cfe", "YAxUnit_Tests_Sklad"));
	RunsRoot = ?(ЗначениеЗаполнено(Параметры.RunsRoot), Окружение.АбсолютныйПуть(Параметры.RunsRoot), Окружение.ОбъединитьПуть(КаталогHarness, "runs"));
	Если Параметры.DryRun Тогда
		Возврат СухойПрогон(BankDir, CfDir, YaxDir, КаталогHarness, КореньРепо);
	КонецЕсли;
	Возврат ВыполнитьПрогон(Параметры, КореньРепо, КаталогHarness, BankDir, CfDir, YaxDir, RunsRoot);
КонецФункции

Функция СухойПрогон(BankDir, CfDir, YaxDir, КаталогHarness, КореньРепо) Экспорт
	Ошибки = Новый Массив;
	Если Не Окружение.ФайлСуществует(Окружение.ОбъединитьПуть(CfDir, "Configuration.xml")) Тогда
		Ошибки.Добавить("missing CF Configuration.xml under " + CfDir);
	КонецЕсли;
	Если Не Окружение.ФайлСуществует(Окружение.ОбъединитьПуть(YaxDir, "Configuration.xml")) Тогда
		Ошибки.Добавить("missing YAxUnit Configuration.xml under " + YaxDir);
	КонецЕсли;
	ВсеXml = Новый Массив;
	Для Каждого Путь Из Окружение.СобратьФайлы(CfDir, Массив1("*.xml")) Цикл
		ВсеXml.Добавить(Путь);
	КонецЦикла;
	Для Каждого Путь Из Окружение.СобратьФайлы(YaxDir, Массив1("*.xml")) Цикл
		ВсеXml.Добавить(Путь);
	КонецЦикла;
	Для Каждого XmlПуть Из ВсеXml Цикл
		Если Не XmlКорректен(XmlПуть) Тогда
			Ошибки.Добавить("XML parse error " + XmlПуть);
		КонецЕсли;
	КонецЦикла;
	Задачи = Окружение.СобратьФайлы(BankDir, Массив1("*.json"), Ложь);
	Если Задачи.Количество() = 0 Тогда
		Ошибки.Добавить("empty bank: " + BankDir);
	КонецЕсли;
	Для Каждого ПутьЗадачи Из Задачи Цикл
		Попытка
			Задача = JsonУтилиты.ПрочитатьФайлJSON(ПутьЗадачи);
		Исключение
			Ошибки.Добавить(Окружение.ИмяФайла(ПутьЗадачи) + ": " + ОписаниеОшибки());
			Продолжить;
		КонецПопытки;
		Для Каждого Ош Из ПроверитьЗадачуБанка(Задача, ПутьЗадачи) Цикл
			Ошибки.Добавить(Ош);
		КонецЦикла;
	КонецЦикла;
	Rashod = Окружение.ОбъединитьПуть(CfDir, "Documents", "РасходТовара", "Ext", "ObjectModule.bsl");
	Http = Окружение.ОбъединитьПуть(CfDir, "HTTPServices", "ОбменСкладом", "Ext", "Module.bsl");
	Если Окружение.ФайлСуществует(Rashod) Тогда
		Текст = Окружение.ПрочитатьТекст(Rashod);
		Если СтрНайти(Текст, "ПередЗаписью") = 0 Или СтрНайти(Текст, "ОстаткиТоваров") = 0 Тогда
			Ошибки.Добавить("РасходТовара ObjectModule missing expected symbols");
		КонецЕсли;
	Иначе
		Ошибки.Добавить("missing " + Rashod);
	КонецЕсли;
	Если Окружение.ФайлСуществует(Http) Тогда
		Если СтрНайти(Окружение.ПрочитатьТекст(Http), "ОстаткиGET") = 0 Тогда
			Ошибки.Добавить("ОбменСкладом missing ОстаткиGET");
		КонецЕсли;
	Иначе
		Ошибки.Добавить("missing " + Http);
	КонецЕсли;
	DocsDir = Окружение.ОбъединитьПуть(КаталогHarness, "docs", "yaxunit");
	Если Не Окружение.КаталогСуществует(DocsDir) Тогда
		Ошибки.Добавить("missing YAxUnit docs pack: " + DocsDir);
	Иначе
		Для Каждого Имя Из ДокументыYaxunit() Цикл
			Док = Окружение.ОбъединитьПуть(DocsDir, Имя);
			Если Не Окружение.ФайлСуществует(Док) Тогда
				Ошибки.Добавить("missing YAxUnit docs file: " + Имя);
				Продолжить;
			КонецЕсли;
			Заголовок = Лев(Окружение.ПрочитатьТекст(Док), 400);
			Если СтрНайти(Заголовок, "Source:") = 0 Тогда
				Ошибки.Добавить(Имя + ": missing Source: URL header");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Протокол = Окружение.ОбъединитьПуть(КореньРепо, "profiles", "1c-shared", "agreements-protocol.md");
	Если Не Окружение.ФайлСуществует(Протокол) Тогда
		Ошибки.Добавить("missing agreements protocol: " + Протокол);
	КонецЕсли;
	Если Ошибки.Количество() > 0 Тогда
		Для Каждого Ош Из Ошибки Цикл
			Сообщить("FAIL: " + Ош);
		КонецЦикла;
		Возврат 1;
	КонецЕсли;
	Сообщить("OK: dry-run passed (" + Строка(Задачи.Количество())
		+ " bank tasks, CF+CFE XML ok, YAxUnit docs pack present, agreements protocol present)");
	Возврат 0;
КонецФункции

Функция ВыполнитьПрогон(Параметры, КореньРепо, КаталогHarness, BankDir, CfDir, YaxDir, RunsRoot)
	ПутьКонфига = Параметры.Config;
	Если Не ЗначениеЗаполнено(ПутьКонфига) Тогда
		Локальный = Окружение.ОбъединитьПуть(КореньРепо, "agent-config.local.yaml");
		Пример = Окружение.ОбъединитьПуть(КореньРепо, "profiles", "1c-analyst", "agent-config.example.yaml");
		ПутьКонфига = ?(Окружение.ФайлСуществует(Локальный), Локальный, Пример);
	КонецЕсли;
	ПутьКонфига = Окружение.АбсолютныйПуть(ПутьКонфига);
	Если Не Окружение.ФайлСуществует(ПутьКонфига) Тогда
		Сообщить("config not found: " + ПутьКонфига);
		Возврат 1;
	КонецЕсли;
	DocsSrc = Окружение.ОбъединитьПуть(КаталогHarness, "docs", "yaxunit");
	Для Каждого Имя Из ДокументыYaxunit() Цикл
		Если Не Окружение.ФайлСуществует(Окружение.ОбъединитьПуть(DocsSrc, Имя)) Тогда
			Сообщить("missing YAxUnit docs pack under " + DocsSrc + ": " + Имя);
			Возврат 1;
		КонецЕсли;
	КонецЦикла;
	Протокол = ПутьПротокола(КореньРепо);
	Если Не Окружение.ФайлСуществует(Протокол) Тогда
		Сообщить("missing agreements protocol: " + Протокол);
		Возврат 1;
	КонецЕсли;
	БазовыйТекст = Окружение.ПрочитатьТекст(ПутьКонфига);
	ApiKeyEnv = КонвейерКонфиг.Провайдер(БазовыйТекст).ApiKeyEnv;
	Если Не ЗначениеЗаполнено(Окружение.ПеременнаяСреды(ApiKeyEnv)) Тогда
		Сообщить("missing provider API key env: " + ApiKeyEnv);
		Возврат 1;
	КонецЕсли;
	Попытка
		Mcp = РазрешитьMcp(КореньРепо);
		BslLs = РазрешитьBslLs(КореньРепо);
	Исключение
		Сообщить(ОписаниеОшибки());
		Возврат 1;
	КонецПопытки;
	Попытка
		AgentBin = РазрешениеKbshff.НайтиБинарник(КореньРепо, Параметры.AgentBin, Ложь);
	Исключение
		Сообщить(ОписаниеОшибки());
		Возврат 1;
	КонецПопытки;
	Попытка
		ОбеспечитьCodeIndex(Mcp.Indexer, CfDir);
	Исключение
		Сообщить(ОписаниеОшибки());
		Возврат 1;
	КонецПопытки;
	Попытка
		ПутиЗадач = ЗагрузитьЗадачи(BankDir, Параметры.TaskIds, Параметры.All);
	Исключение
		Сообщить(ОписаниеОшибки());
		Возврат 1;
	КонецПопытки;
	RunId = Формат(ТекущаяУниверсальнаяДата(), "ДФ=yyyyMMdd-HHmmss");
	RunDir = Окружение.ОбъединитьПуть(RunsRoot, RunId);
	Окружение.ОбеспечитьКаталог(RunDir);
	Окружение.ЗаписатьТекст(Окружение.ОбъединитьПуть(RunsRoot, "LATEST"), RunDir);
	Результаты = Новый Массив;
	Passed = 0;
	Failed = 0;
	Для Каждого ПутьЗадачи Из ПутиЗадач Цикл
		СтрокаОтчёта = ВыполнитьЗадачу(ПутьЗадачи, Параметры, КореньРепо, КаталогHarness, CfDir, YaxDir, RunDir, RunId, AgentBin, БазовыйТекст, Mcp, BslLs);
		Результаты.Добавить(СтрокаОтчёта);
		Если СтрокаОтчёта.Получить("pass") = Истина Тогда
			Passed = Passed + 1;
			Сообщить("PASS " + СтрокаОтчёта.Получить("id"));
		Иначе
			Failed = Failed + 1;
			Сообщить("FAIL " + СтрокаОтчёта.Получить("id") + ": " + JsonУтилиты.ВJSON(СтрокаОтчёта.Получить("failures")));
		КонецЕсли;
	КонецЦикла;
	Отчёт = Новый Соответствие;
	Отчёт.Вставить("run_id", RunId);
	Отчёт.Вставить("product", "sklad");
	Отчёт.Вставить("bank_dir", BankDir);
	Отчёт.Вставить("passed", Passed);
	Отчёт.Вставить("failed", Failed);
	Отчёт.Вставить("total", Результаты.Количество());
	Отчёт.Вставить("tasks", Результаты);
	ПутьОтчёта = Окружение.ОбъединитьПуть(RunDir, "report.json");
	JsonУтилиты.ЗаписатьФайлJSON(ПутьОтчёта, Отчёт);
	ЗаписатьЗаметкиПрогона(RunDir, Окружение.ОбъединитьПуть(КаталогHarness, "notes"), Отчёт);
	Сообщить("report: " + ПутьОтчёта);
	Возврат ?(Failed = 0, 0, 1);
КонецФункции

Функция ВыполнитьЗадачу(ПутьЗадачи, Параметры, КореньРепо, КаталогHarness, CfDir, YaxDir, RunDir, RunId, AgentBin, БазовыйТекст, Mcp, BslLs)
	Задача = JsonУтилиты.ПрочитатьФайлJSON(ПутьЗадачи);
	TaskId = Строка(JsonУтилиты.ПолучитьПоле(Задача, "id", Окружение.ИмяБезРасширения(ПутьЗадачи)));
	Ожидание = JsonУтилиты.ПолучитьПоле(Задача, "expect");
	Если Не JsonУтилиты.ЭтоСоответствие(Ожидание) Тогда
		Ожидание = Новый Соответствие;
	КонецЕсли;
	СтадииНужны = JsonУтилиты.ПолучитьПоле(Задача, "stages");
	Если Не JsonУтилиты.ЭтоМассив(СтадииНужны) Тогда
		СтадииНужны = ИменаСтадийПоУмолчанию();
	КонецЕсли;
	TaskDir = Окружение.ОбъединитьПуть(RunDir, TaskId);
	Окружение.ОбеспечитьКаталог(TaskDir);
	ProjectRoot = Окружение.ОбъединитьПуть(TaskDir, "project");
	CfCopy = Окружение.ОбъединитьПуть(TaskDir, "cf");
	Окружение.КопироватьДерево(CfDir, CfCopy);
	FpBefore = ХешДерева.Отпечаток(CfCopy);
	Выводы = Новый Соответствие;
	Дома = Новый Соответствие;
	ОшибкиСкоринг = Новый Массив;
	ТекстОшибки = Неопределено;
	Ок = Ложь;
	YaxStatus = "skipped";
	Попытка
		Для Каждого Описание Из ОписаниеСтадий() Цикл
			Если Не МассивСодержит(СтадииНужны, Описание.Имя) Тогда
				Продолжить;
			КонецЕсли;
			Settings = Окружение.ОбъединитьПуть(КореньРепо, "profiles", Описание.Агент);
			Если Не Окружение.КаталогСуществует(Settings) Тогда
				ВызватьИсключение "missing settings: " + Settings;
			КонецЕсли;
			ОбеспечитьПрофиль(AgentBin, ProjectRoot, Описание.Агент, Settings);
		КонецЦикла;
		Для Каждого Описание Из ОписаниеСтадий() Цикл
			Если Не МассивСодержит(СтадииНужны, Описание.Имя) Тогда
				Продолжить;
			КонецЕсли;
			HomeRel = "homes/" + TaskId + "/" + Описание.Имя;
			HomeDir = Окружение.ОбъединитьПуть(ProjectRoot, ".kuibysheff", "homes", TaskId, Описание.Имя);
			Окружение.УдалитьДерево(HomeDir);
			Окружение.ОбеспечитьКаталог(Окружение.ОбъединитьПуть(HomeDir, "in"));
			Окружение.ОбеспечитьКаталог(Окружение.ОбъединитьПуть(HomeDir, "out"));
			Окружение.ОбеспечитьКаталог(Окружение.ОбъединитьПуть(HomeDir, "notes"));
			Дома.Вставить(Описание.Имя, HomeDir);
			LogDir = Окружение.ОбъединитьПуть(TaskDir, "logs", Описание.Имя);
			CfgOut = Окружение.ОбъединитьПуть(ProjectRoot, ".kuibysheff", "protected", "agents", Описание.Агент, "agent-config.yaml");
			BslДляСтадии = Неопределено;
			Если Описание.Имя = "yaxunit" Или Описание.Имя = "coder" Или Описание.Имя = "implementer" Тогда
				BslДляСтадии = BslLs;
			КонецЕсли;
			КонвейерКонфиг.Записать(CfgOut, БазовыйТекст, LogDir, CfCopy, CfDir, Mcp.SntxConfig, Mcp.Indexer, Mcp.Command, Mcp.Args, Параметры.WithSearxng И (Описание.Имя = "analyst" Или Описание.Имя = "yaxunit"), BslДляСтадии, Описание.Имя);
			ПрименитьПровайдераCli(AgentBin, ProjectRoot, Описание.Агент, БазовыйТекст);
			ПодготовитьВходСтадии(Описание.Имя, HomeDir, Задача, TaskId, CfCopy, CfDir, Дома, КаталогHarness);
			AnalystAgr = Неопределено;
			Если Описание.Имя <> "analyst" Тогда
				Ah = Дома.Получить("analyst");
				Если Ah <> Неопределено Тогда
					AnalystAgr = Окружение.ОбъединитьПуть(Ah, "out", "agreements.md");
				КонецЕсли;
			КонецЕсли;
			ПосеятьДоговорённости(HomeDir, TaskId, Ожидание, ПутьПротокола(КореньРепо), AnalystAgr);
			Вывод = ЗапуститьАгента(AgentBin, ProjectRoot, Описание.Агент, HomeRel, КонвейерПромпты.ДляСтадии(Описание.Имя, "sklad", Ожидание), Окружение.ОбъединитьПуть(TaskDir, "logs", Описание.Имя + ".run.json"));
			Выводы.Вставить(Описание.Имя, Вывод);
		КонецЦикла;
		FpAfter = ХешДерева.Отпечаток(CfCopy);
		Оценка = Скоринг.ОценитьЗадачу(Ожидание, Дома, Выводы, FpBefore = FpAfter);
		Ок = Оценка.Ок;
		Для Каждого Эл Из Оценка.Ошибки Цикл
			ОшибкиСкоринг.Добавить(Эл);
		КонецЦикла;
		GeneratedYax = СгенерированныйYaxunit(Дома, YaxDir);
		ImplHome = Дома.Получить("implementer");
		CfeOut = ?(ImplHome = Неопределено, "", Окружение.ОбъединитьПуть(ImplHome, "out", "cfe"));
		YaxStatus = ВызватьПлатформу(Параметры.RequirePlatform, CfCopy, GeneratedYax, CfeOut, Окружение.ОбъединитьПуть(TaskDir, "yaxunit"), TaskDir, ОшибкиСкоринг);
		Если Параметры.RequirePlatform И (YaxStatus = "error" Или YaxStatus = "failed") Тогда
			Ок = Ложь;
		КонецЕсли;
		Если Не Ок И ОшибкиСкоринг.Количество() = 0 Тогда
			ОшибкиСкоринг.Добавить("scoring failed");
		КонецЕсли;
	Исключение
		Ок = Ложь;
		ТекстОшибки = ОписаниеОшибки();
		ОшибкиСкоринг.Добавить(ТекстОшибки);
		YaxStatus = "skipped";
	КонецПопытки;
	СтрокаОтчёта = Новый Соответствие;
	СтрокаОтчёта.Вставить("id", TaskId);
	СтрокаОтчёта.Вставить("pass", Ок);
	СтрокаОтчёта.Вставить("failures", ОшибкиСкоринг);
	СтрокаОтчёта.Вставить("error", ТекстОшибки);
	СтрокаОтчёта.Вставить("yaxunit", YaxStatus);
	СтадииОтчёт = Новый Соответствие;
	Для Каждого Описание Из ОписаниеСтадий() Цикл
		Вывод = Выводы.Получить(Описание.Имя);
		Если Вывод = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Кусок = Новый Соответствие;
		Кусок.Вставить("stop_reason", JsonУтилиты.ПолучитьПоле(Вывод, "stop_reason"));
		Кусок.Вставить("result", JsonУтилиты.ПолучитьПоле(Вывод, "result"));
		Кусок.Вставить("usage", JsonУтилиты.ПолучитьПоле(Вывод, "usage"));
		СтадииОтчёт.Вставить(Описание.Имя, Кусок);
	КонецЦикла;
	СтрокаОтчёта.Вставить("stages", СтадииОтчёт);
	ЗаписатьЗаметкиЗадачи(Окружение.ОбъединитьПуть(КаталогHarness, "notes"), TaskDir, RunId, СтрокаОтчёта, Ожидание, Дома);
	Возврат СтрокаОтчёта;
КонецФункции

Функция ВызватьПлатформу(RequirePlatform, CfCopy, YaxDir, CfeOut, WorkDir, TaskDir, ОшибкиСкоринг)
	Попытка
		Шаг = ПлатформенныйШаг.ВыполнитьШаг(CfCopy, YaxDir, CfeOut, WorkDir, RequirePlatform);
	Исключение
		Если RequirePlatform Тогда
			ОшибкиСкоринг.Добавить(ОписаниеОшибки());
			Возврат "error";
		КонецЕсли;
		Возврат "skipped";
	КонецПопытки;
	Окружение.ЗаписатьТекст(Окружение.ОбъединитьПуть(TaskDir, "logs", "yaxunit.txt"), Шаг.Вывод + Символы.ПС + Шаг.Ошибки);
	Если RequirePlatform Тогда
		Если Шаг.Код <> 0 Тогда
			ОшибкиСкоринг.Добавить("YAxUnit failed (exit " + Строка(Шаг.Код) + "): " + Лев(Шаг.Ошибки + Шаг.Вывод, 400));
			Возврат "failed";
		КонецЕсли;
		Возврат "passed";
	КонецЕсли;
	Если СтрНайти(Шаг.Вывод, "SKIP:") > 0 Тогда
		Возврат "skipped";
	ИначеЕсли Шаг.Код = 0 Тогда
		Возврат "passed";
	КонецЕсли;
	Возврат "skipped";
КонецФункции

Процедура ПодготовитьВходСтадии(Имя, HomeDir, Задача, TaskId, CfCopy, CfDir, Дома, КаталогHarness)
	InDir = Окружение.ОбъединитьПуть(HomeDir, "in");
	Если Имя = "analyst" Тогда
		Окружение.ЗаписатьТекст(Окружение.ОбъединитьПуть(InDir, "task_brief.md"), Строка(JsonУтилиты.ПолучитьПоле(Задача, "brief", "")));
		Product = Новый Соответствие;
		Product.Вставить("id", "sklad");
		Product.Вставить("name", "Склад");
		Product.Вставить("cf_root", CfCopy);
		Product.Вставить("code_index_repo", "cf");
		Product.Вставить("code_index_root", CfDir);
		Product.Вставить("task_id", TaskId);
		JsonУтилиты.ЗаписатьФайлJSON(Окружение.ОбъединитьПуть(InDir, "product.json"), Product);
	ИначеЕсли Имя = "yaxunit" Тогда
		Окружение.КопироватьСодержимоеКаталога(Окружение.ОбъединитьПуть(Дома.Получить("analyst"), "out"), InDir);
		Окружение.ЗаписатьТекст(Окружение.ОбъединитьПуть(InDir, "APPROVED"), "approved" + Символы.ПС);
		DocsSrc = Окружение.ОбъединитьПуть(КаталогHarness, "docs", "yaxunit");
		Если Окружение.КаталогСуществует(DocsSrc) Тогда
			Окружение.КопироватьДерево(DocsSrc, Окружение.ОбъединитьПуть(InDir, "docs"));
		КонецЕсли;
		Brief = Строка(JsonУтилиты.ПолучитьПоле(Задача, "brief", ""));
		Если ЗначениеЗаполнено(Brief) Тогда
			Окружение.ЗаписатьТекст(Окружение.ОбъединитьПуть(InDir, "task_brief.md"), Brief);
		КонецЕсли;
		Lint = Новый Соответствие;
		Lint.Вставить("tool", "bsl-language-server.analyze");
		Dirs = Новый Массив;
		Dirs.Добавить(Окружение.АбсолютныйПуть(Окружение.ОбъединитьПуть(HomeDir, "out", "tests")));
		Dirs.Добавить(Окружение.АбсолютныйПуть(Окружение.ОбъединитьПуть(HomeDir, "out", "cfe-tests")));
		Lint.Вставить("src_dirs", Dirs);
		JsonУтилиты.ЗаписатьФайлJSON(Окружение.ОбъединитьПуть(InDir, "bsl-lint.json"), Lint);
	ИначеЕсли Имя = "coder" Тогда
		Окружение.КопироватьСодержимоеКаталога(Окружение.ОбъединитьПуть(Дома.Получить("analyst"), "out"), InDir);
		Окружение.ЗаписатьТекст(Окружение.ОбъединитьПуть(InDir, "APPROVED"), "approved" + Символы.ПС);
		YaxHome = Дома.Получить("yaxunit");
		Если YaxHome <> Неопределено Тогда
			СкопироватьТестыДляCoder(YaxHome, Окружение.ОбъединитьПуть(InDir, "tests"));
		КонецЕсли;
		Lint = Новый Соответствие;
		Lint.Вставить("tool", "bsl-language-server.analyze");
		Dirs = Новый Массив;
		Dirs.Добавить(Окружение.АбсолютныйПуть(Окружение.ОбъединитьПуть(HomeDir, "out", "src")));
		Lint.Вставить("src_dirs", Dirs);
		JsonУтилиты.ЗаписатьФайлJSON(Окружение.ОбъединитьПуть(InDir, "bsl-lint.json"), Lint);
	ИначеЕсли Имя = "implementer" Тогда
		AnalystOut = Окружение.ОбъединитьПуть(Дома.Получить("analyst"), "out");
		Для Каждого ИмяФайла Из СтрРазделить("cfe-scope.md,architecture.md,tasks.md,prd.md,agreements.md", ",", Ложь) Цикл
			Src = Окружение.ОбъединитьПуть(AnalystOut, ИмяФайла);
			Если Окружение.ФайлСуществует(Src) Тогда
				КопироватьФайл(Src, Окружение.ОбъединитьПуть(InDir, ИмяФайла));
			КонецЕсли;
		КонецЦикла;
		Окружение.КопироватьСодержимоеКаталога(Окружение.ОбъединитьПуть(Дома.Получить("coder"), "out"), Окружение.ОбъединитьПуть(InDir, "coder"));
		YaxHome = Дома.Получить("yaxunit");
		Если YaxHome <> Неопределено Тогда
			CfeTests = Окружение.ОбъединитьПуть(YaxHome, "out", "cfe-tests");
			Если Окружение.КаталогСуществует(CfeTests) Тогда
				Окружение.КопироватьДерево(CfeTests, Окружение.ОбъединитьПуть(InDir, "cfe-tests"));
			КонецЕсли;
		КонецЕсли;
		Lint = Новый Соответствие;
		Lint.Вставить("tool", "bsl-language-server.analyze");
		Dirs = Новый Массив;
		Dirs.Добавить(Окружение.АбсолютныйПуть(Окружение.ОбъединитьПуть(HomeDir, "out", "cfe")));
		Dirs.Добавить(Окружение.АбсолютныйПуть(Окружение.ОбъединитьПуть(HomeDir, "out", "cfe-tests")));
		Lint.Вставить("src_dirs", Dirs);
		JsonУтилиты.ЗаписатьФайлJSON(Окружение.ОбъединитьПуть(InDir, "bsl-lint.json"), Lint);
	КонецЕсли;
КонецПроцедуры

Процедура ПосеятьДоговорённости(HomeDir, TaskId, Ожидание, Протокол, AnalystAgr)
	Dest = Окружение.ОбъединитьПуть(HomeDir, "in");
	Окружение.ОбеспечитьКаталог(Dest);
	Если Окружение.ФайлСуществует(Протокол) Тогда
		КопироватьФайл(Протокол, Окружение.ОбъединитьПуть(Dest, "agreements-protocol.md"));
	КонецЕсли;
	Payload = Новый Соответствие;
	Payload.Вставить("id", TaskId);
	Payload.Вставить("expect", Ожидание);
	JsonУтилиты.ЗаписатьФайлJSON(Окружение.ОбъединитьПуть(Dest, "agreements.json"), Payload);
	JsonУтилиты.ЗаписатьФайлJSON(Окружение.ОбъединитьПуть(Dest, "expect.json"), Ожидание);
	Если ЗначениеЗаполнено(AnalystAgr) И Окружение.ФайлСуществует(AnalystAgr) Тогда
		КопироватьФайл(AnalystAgr, Окружение.ОбъединитьПуть(Dest, "agreements.md"));
	КонецЕсли;
КонецПроцедуры

Процедура СкопироватьТестыДляCoder(YaxHome, Dest)
	TestsSrc = Окружение.ОбъединитьПуть(YaxHome, "out", "tests");
	Файлы = Окружение.СобратьФайлы(TestsSrc);
	Если Окружение.КаталогСуществует(TestsSrc) И Файлы.Количество() > 0 Тогда
		Окружение.КопироватьДерево(TestsSrc, Dest);
		Возврат;
	КонецЕсли;
	CfeTests = Окружение.ОбъединитьПуть(YaxHome, "out", "cfe-tests");
	Если Не Окружение.КаталогСуществует(CfeTests) Тогда
		Возврат;
	КонецЕсли;
	Окружение.ОбеспечитьКаталог(Dest);
	Для Каждого Bsl Из Окружение.СобратьФайлы(CfeTests, Массив1("*.bsl")) Цикл
		КопироватьФайл(Bsl, Окружение.ОбъединитьПуть(Dest, Окружение.ИмяФайла(Bsl)));
	КонецЦикла;
КонецПроцедуры

Процедура ОбеспечитьПрофиль(AgentBin, ProjectRoot, AgentId, SettingsDir)
	Окружение.ОбеспечитьКаталог(ProjectRoot);
	Аргументы = Новый Массив;
	Аргументы.Добавить("init");
	Аргументы.Добавить(AgentId);
	Аргументы.Добавить("--project-root");
	Аргументы.Добавить(ProjectRoot);
	Аргументы.Добавить("--force");
	Init = Окружение.ЗапуститьПрограмму(AgentBin, Аргументы);
	Если Init.Код <> 0 Тогда
		ВызватьИсключение "init " + AgentId + " failed (exit " + Строка(Init.Код) + "): " + СокрЛП(Init.Ошибки + Init.Вывод);
	КонецЕсли;
	Staging = Окружение.ОбъединитьПуть(ProjectRoot, ".kuibysheff", ".1c-live-import", AgentId);
	Окружение.УдалитьДерево(Staging);
	Окружение.ОбеспечитьКаталог(Staging);
	Для Каждого Имя Из СтрРазделить("master_prompt.md,skills.dsl,rules.md", ",", Ложь) Цикл
		Src = Окружение.ОбъединитьПуть(SettingsDir, Имя);
		Если Окружение.ФайлСуществует(Src) Тогда
			КопироватьФайл(Src, Окружение.ОбъединитьПуть(Staging, Имя));
		КонецЕсли;
	КонецЦикла;
	Аргументы = Новый Массив;
	Аргументы.Добавить("config");
	Аргументы.Добавить("--project-root");
	Аргументы.Добавить(ProjectRoot);
	Аргументы.Добавить("--agent");
	Аргументы.Добавить(AgentId);
	Аргументы.Добавить("import");
	Аргументы.Добавить("--from");
	Аргументы.Добавить(Staging);
	Аргументы.Добавить("--force");
	Импорт = Окружение.ЗапуститьПрограмму(AgentBin, Аргументы);
	Если Импорт.Код <> 0 Тогда
		ВызватьИсключение "config import " + AgentId + " failed (exit " + Строка(Импорт.Код) + "): " + СокрЛП(Импорт.Ошибки + Импорт.Вывод);
	КонецЕсли;
КонецПроцедуры

Процедура ПрименитьПровайдераCli(AgentBin, ProjectRoot, AgentId, БазовыйТекст)
	Пров = КонвейерКонфиг.Провайдер(БазовыйТекст);
	Аргументы = Новый Массив;
	Аргументы.Добавить("config");
	Аргументы.Добавить("--project-root");
	Аргументы.Добавить(ProjectRoot);
	Аргументы.Добавить("--agent");
	Аргументы.Добавить(AgentId);
	Аргументы.Добавить("provider");
	Аргументы.Добавить("set");
	Аргументы.Добавить("--base-url");
	Аргументы.Добавить(Пров.BaseUrl);
	Аргументы.Добавить("--model");
	Аргументы.Добавить(Пров.Модель);
	Аргументы.Добавить("--api-key-env");
	Аргументы.Добавить(Пров.ApiKeyEnv);
	Если ЗначениеЗаполнено(Пров.TimeoutMs) Тогда
		Аргументы.Добавить("--timeout-ms");
		Аргументы.Добавить(Пров.TimeoutMs);
	КонецЕсли;
	Запуск = Окружение.ЗапуститьПрограмму(AgentBin, Аргументы);
	Если Запуск.Код <> 0 Тогда
		ВызватьИсключение "config provider set " + AgentId + " failed (exit " + Строка(Запуск.Код) + "): " + СокрЛП(Запуск.Ошибки + Запуск.Вывод);
	КонецЕсли;
КонецПроцедуры

Функция ЗапуститьАгента(AgentBin, ProjectRoot, AgentId, HomeRel, Промпт, LogPath)
	Аргументы = Новый Массив;
	Аргументы.Добавить("run");
	Аргументы.Добавить("--project-root");
	Аргументы.Добавить(ProjectRoot);
	Аргументы.Добавить("--agent");
	Аргументы.Добавить(AgentId);
	Аргументы.Добавить("--home");
	Аргументы.Добавить(HomeRel);
	Аргументы.Добавить("--prompt");
	Аргументы.Добавить(Промпт);
	Запуск = Окружение.ЗапуститьПрограмму(AgentBin, Аргументы);
	Лог = Новый Соответствие;
	Лог.Вставить("cmd", СобратьCmd(AgentBin, Аргументы));
	Лог.Вставить("returncode", Запуск.Код);
	Лог.Вставить("stdout", Запуск.Вывод);
	Лог.Вставить("stderr", Запуск.Ошибки);
	JsonУтилиты.ЗаписатьФайлJSON(LogPath, Лог);
	Если Не ЗначениеЗаполнено(СокрЛП(Запуск.Вывод)) Тогда
		ВызватьИсключение "empty stdout from " + AgentId + " (exit " + Строка(Запуск.Код) + "): " + Лев(Запуск.Ошибки, 500);
	КонецЕсли;
	Возврат JsonУтилиты.ИзвлечьОбъектJSON(Запуск.Вывод);
КонецФункции

Функция СобратьCmd(Exe, Аргументы)
	Cmd = Новый Массив;
	Cmd.Добавить(Exe);
	Для Каждого Арг Из Аргументы Цикл
		Cmd.Добавить(Арг);
	КонецЦикла;
	Возврат Cmd;
КонецФункции

Функция РазрешитьMcp(КореньРепо)
	Sntx = Окружение.ПеременнаяСреды("SNTX_SEM_CONFIG");
	Indexer = Окружение.ПеременнаяСреды("BSL_INDEXER");
	Если Не ЗначениеЗаполнено(Indexer) Тогда
		Indexer = Окружение.ПеременнаяСреды("CODE_INDEX_BIN");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Indexer) Тогда
		Indexer = Окружение.ПеременнаяСреды("BSL_INDEXER_EXE");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Sntx) Тогда
		Кандидат = Окружение.ОбъединитьПуть(КореньРепо, "tools", "1c-sntx-sem", "config.yaml");
		Если Окружение.ФайлСуществует(Кандидат) Тогда
			Sntx = Кандидат;
		КонецЕсли;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Sntx) Тогда
		ВызватьИсключение "SNTX_SEM_CONFIG is required (path to 1c-sntx-sem config.yaml).";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Indexer) Тогда
		Для Каждого Имя Из СтрРазделить("bsl-indexer.exe,bsl-indexer", ",", Ложь) Цикл
			Кандидат = Окружение.ОбъединитьПуть(КореньРепо, "tools", Имя);
			Если Окружение.ФайлСуществует(Кандидат) Тогда
				Indexer = Кандидат;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Indexer) Тогда
		Для Каждого Имя Из СтрРазделить("bsl-indexer.exe,bsl-indexer", ",", Ложь) Цикл
			Кандидат = Окружение.ОбъединитьПуть(КореньРепо, "tools", "code-index", Имя);
			Если Окружение.ФайлСуществует(Кандидат) Тогда
				Indexer = Кандидат;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Indexer) Тогда
		ВызватьИсключение "BSL_INDEXER / CODE_INDEX_BIN is required (path to bsl-indexer).";
	КонецЕсли;
	Если Не Окружение.ФайлСуществует(Sntx) Тогда
		ВызватьИсключение "SNTX_SEM_CONFIG file not found: " + Sntx;
	КонецЕсли;
	Если Не Окружение.ФайлСуществует(Indexer) Тогда
		ВызватьИсключение "bsl-indexer not found: " + Indexer;
	КонецЕсли;
	Command = Окружение.ПеременнаяСреды("SNTX_SEM_PYTHON");
	Args = Новый Массив;
	Если Не ЗначениеЗаполнено(Command) Тогда
		КореньSntx = Окружение.РодительскийКаталог(Окружение.АбсолютныйПуть(Sntx));
		Для Каждого Отн Из СтрРазделить(".venv/Scripts/python.exe,.venv/bin/python", ",", Ложь) Цикл
			Части = СтрРазделить(Отн, "/", Ложь);
			Кандидат = КореньSntx;
			Для Каждого Часть Из Части Цикл
				Кандидат = Окружение.ОбъединитьПуть(Кандидат, Часть);
			КонецЦикла;
			Если Окружение.ФайлСуществует(Кандидат) Тогда
				Command = Кандидат;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если ЗначениеЗаполнено(Command) Тогда
		Args.Добавить("-m");
		Args.Добавить("sntx_sem.mcp_server");
	Иначе
		Command = Окружение.НайтиВPath("sntx-sem");
		Если Не ЗначениеЗаполнено(Command) Тогда
			ВызватьИсключение "SNTX_SEM_PYTHON not found (set it, create 1c-sntx-sem/.venv, or put sntx-sem on PATH).";
		КонецЕсли;
		Args.Добавить("mcp");
	КонецЕсли;
	Если Не Окружение.ФайлСуществует(Command) Тогда
		ВызватьИсключение "sntx_sem command not found: " + Command;
	КонецЕсли;
	Результат = Новый Структура;
	Результат.Вставить("SntxConfig", Sntx);
	Результат.Вставить("Indexer", Indexer);
	Результат.Вставить("Command", Command);
	Результат.Вставить("Args", Args);
	Возврат Результат;
КонецФункции

Функция РазрешитьBslLs(КореньРепо = "")
	Node = Окружение.ПеременнаяСреды("BSL_LS_NODE");
	Если Не ЗначениеЗаполнено(Node) Тогда
		Node = Окружение.НайтиВPath("node");
	КонецЕсли;
	ServerJs = Окружение.ПеременнаяСреды("BSL_LS_MCP");
	Если Не ЗначениеЗаполнено(ServerJs) Тогда
		ServerJs = Окружение.ПеременнаяСреды("BSL_LS_SERVER");
	КонецЕсли;
	Jar = Окружение.ПеременнаяСреды("BSL_LS_JAR");
	JavaHome = Окружение.ПеременнаяСреды("JAVA_HOME");
	Если Не ЗначениеЗаполнено(ServerJs) И ЗначениеЗаполнено(КореньРепо) Тогда
		Кандидат = Окружение.ОбъединитьПуть(КореньРепо, "tools", "bsl-ls-mcp", "server.js");
		Если Окружение.ФайлСуществует(Кандидат) Тогда
			ServerJs = Кандидат;
		КонецЕсли;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ServerJs) Тогда
		Дом = Окружение.ДомашнийКаталог();
		Кандидат = Окружение.ОбъединитьПуть(Дом, ".claude", "bsl-ls-mcp", "server.js");
		Если Окружение.ФайлСуществует(Кандидат) Тогда
			ServerJs = Кандидат;
		КонецЕсли;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Jar) И ЗначениеЗаполнено(КореньРепо) Тогда
		Кандидат = Окружение.ОбъединитьПуть(КореньРепо, "tools", "bsl-ls", "bsl-language-server.jar");
		Если Окружение.ФайлСуществует(Кандидат) Тогда
			Jar = Кандидат;
		КонецЕсли;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Jar) Тогда
		Дом = Окружение.ДомашнийКаталог();
		Кандидат = Окружение.ОбъединитьПуть(Дом, ".claude", "bsl-ls", "bsl-language-server.jar");
		Если Окружение.ФайлСуществует(Кандидат) Тогда
			Jar = Кандидат;
		ИначеЕсли ЗначениеЗаполнено(ServerJs) Тогда
			Кандидат = Окружение.ОбъединитьПуть(Окружение.РодительскийКаталог(Окружение.РодительскийКаталог(ServerJs)), "bsl-ls", "bsl-language-server.jar");
			Если Окружение.ФайлСуществует(Кандидат) Тогда
				Jar = Кандидат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Если Не Окружение.ФайлСуществует(Node) Тогда
		ВызватьИсключение "Node.js required for bsl-language-server MCP (set BSL_LS_NODE or put node on PATH).";
	КонецЕсли;
	Если Не Окружение.ФайлСуществует(ServerJs) Тогда
		ВызватьИсключение "BSL_LS_MCP / BSL_LS_SERVER is required (path to bsl-ls-mcp/server.js, as in the ЗУП project).";
	КонецЕсли;
	Если Не Окружение.ФайлСуществует(Jar) Тогда
		ВызватьИсключение "BSL_LS_JAR is required (path to bsl-language-server exec jar).";
	КонецЕсли;
	Результат = Новый Структура;
	Результат.Вставить("Node", Node);
	Результат.Вставить("ServerJs", ServerJs);
	Результат.Вставить("Jar", Jar);
	Результат.Вставить("JavaHome", JavaHome);
	Возврат Результат;
КонецФункции

Процедура ОбеспечитьCodeIndex(Indexer, CfRoot)
	CfRoot = Окружение.АбсолютныйПуть(CfRoot);
	Home = Окружение.ПеременнаяСреды("CODE_INDEX_HOME");
	Если Не ЗначениеЗаполнено(Home) Тогда
		Home = Окружение.КаталогФайла(Окружение.АбсолютныйПуть(Indexer));
	КонецЕсли;
	DaemonToml = Окружение.ОбъединитьПуть(Home, "daemon.toml");
	Если Не DaemonОтслеживает(DaemonToml, CfRoot) Тогда
		Блок = Символы.ПС + "[[paths]]" + Символы.ПС
			+ "path = """ + СтрЗаменить(CfRoot, "\", "\\") + """" + Символы.ПС
			+ "language = ""bsl""" + Символы.ПС;
		Если Окружение.ФайлСуществует(DaemonToml) Тогда
			Существующий = Окружение.ПрочитатьТекст(DaemonToml);
			Если Не СтрЗаканчиваетсяНа(Существующий, Символы.ПС) Тогда
				Существующий = Существующий + Символы.ПС;
			КонецЕсли;
			Окружение.ЗаписатьТекст(DaemonToml, Существующий + Блок);
		Иначе
			Окружение.ОбеспечитьКаталог(Home);
			Окружение.ЗаписатьТекст(DaemonToml, "[daemon]" + Символы.ПС + "http_port = 0" + Символы.ПС + "max_concurrent_initial = 1" + Символы.ПС + Блок);
		КонецЕсли;
		Сообщить("code-index: added " + CfRoot + " to " + DaemonToml);
	КонецЕсли;
	Аргументы = Новый Массив;
	Аргументы.Добавить("daemon");
	Аргументы.Добавить("reload");
	Reload = Окружение.ЗапуститьПрограмму(Indexer, Аргументы);
	Если Reload.Код <> 0 Тогда
		АргументыС = Новый Массив;
		АргументыС.Добавить("daemon");
		АргументыС.Добавить("status");
		Status = Окружение.ЗапуститьПрограмму(Indexer, АргументыС);
		ВызватьИсключение "code-index daemon did not reload after registering CF. Start/reload the daemon (CODE_INDEX_HOME=" + Home + "). Details:" + Символы.ПС + СокрЛП(Reload.Ошибки + Reload.Вывод + Status.Вывод);
	КонецЕсли;
	Игла = CfRoot;
	Край = ТекущаяУниверсальнаяДатаВМиллисекундах() + 120000;
	Последний = "";
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() <= Край Цикл
		АргументыС = Новый Массив;
		АргументыС.Добавить("daemon");
		АргументыС.Добавить("status");
		Status = Окружение.ЗапуститьПрограмму(Indexer, АргументыС);
		Последний = Status.Вывод + Status.Ошибки;
		Если СтрНайти(Последний, Игла) > 0 Или СтрНайти(Последний, СтрЗаменить(Игла, "\", "/")) > 0 Тогда
			Сообщить("code-index: tracked " + CfRoot);
			Возврат;
		КонецЕсли;
		Приостановить(1500);
	КонецЦикла;
	ВызватьИсключение "code-index daemon did not report " + CfRoot + " within 120s." + Символы.ПС + Последний;
КонецПроцедуры

Функция DaemonОтслеживает(DaemonToml, CfRoot)
	Если Не Окружение.ФайлСуществует(DaemonToml) Тогда
		Возврат Ложь;
	КонецЕсли;
	Текст = Окружение.ПрочитатьТекст(DaemonToml);
	Цель = Окружение.АбсолютныйПуть(CfRoot);
	Возврат СтрНайти(Текст, Цель) > 0 Или СтрНайти(Текст, СтрЗаменить(Цель, "\", "/")) > 0 Или СтрНайти(Текст, СтрЗаменить(Цель, "\", "\\")) > 0;
КонецФункции

Функция ЗагрузитьЗадачи(BankDir, TaskIds, RunAll)
	Все = Окружение.СобратьФайлы(BankDir, Массив1("*.json"), Ложь);
	Если RunAll Тогда
		Возврат Все;
	КонецЕсли;
	Нужные = Новый Соответствие;
	Если TaskIds.Количество() = 0 Тогда
		Нужные.Вставить("cfe-qty-check-01", Истина);
	Иначе
		Для Каждого Ид Из TaskIds Цикл
			Нужные.Вставить(Ид, Истина);
		КонецЦикла;
	КонецЕсли;
	Выбранные = Новый Массив;
	Для Каждого Путь Из Все Цикл
		Если Нужные.Получить(Окружение.ИмяБезРасширения(Путь)) = Истина Тогда
			Выбранные.Добавить(Путь);
		КонецЕсли;
	КонецЦикла;
	Для Каждого КЗ Из Нужные Цикл
		Есть = Ложь;
		Для Каждого Путь Из Выбранные Цикл
			Если Окружение.ИмяБезРасширения(Путь) = КЗ.Ключ Тогда
				Есть = Истина;
			КонецЕсли;
		КонецЦикла;
		Если Не Есть Тогда
			ВызватьИсключение "task(s) not found in bank: " + КЗ.Ключ;
		КонецЕсли;
	КонецЦикла;
	Возврат Выбранные;
КонецФункции

Функция ПроверитьЗадачуБанка(Задача, Путь)
	Ошибки = Новый Массив;
	Имя = Окружение.ИмяФайла(Путь);
	Если Не ЗначениеЗаполнено(JsonУтилиты.ПолучитьПоле(Задача, "id")) Тогда
		Ошибки.Добавить(Имя + ": missing id");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(JsonУтилиты.ПолучитьПоле(Задача, "brief")) Тогда
		Ошибки.Добавить(Имя + ": missing brief");
	КонецЕсли;
	Стадии = JsonУтилиты.ПолучитьПоле(Задача, "stages");
	Если Стадии <> Неопределено Тогда
		Если Не JsonУтилиты.ЭтоМассив(Стадии) Или Стадии.Количество() = 0 Тогда
			Ошибки.Добавить(Имя + ": stages must be a non-empty list");
		Иначе
			Для Каждого С Из Стадии Цикл
				Если Не МассивСодержит(ИменаСтадийПоУмолчанию(), С) Тогда
					Ошибки.Добавить(Имя + ": unknown stages '" + С + "'");
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Ожидание = JsonУтилиты.ПолучитьПоле(Задача, "expect");
	Если Не JsonУтилиты.ЭтоСоответствие(Ожидание) Тогда
		Ошибки.Добавить(Имя + ": expect must be object");
		Возврат Ошибки;
	КонецЕсли;
	Если JsonУтилиты.ПолучитьПоле(Ожидание, "plan_files") = Неопределено Тогда
		Ошибки.Добавить(Имя + ": expect.plan_files required");
	КонецЕсли;
	Brief = Строка(JsonУтилиты.ПолучитьПоле(Задача, "brief", ""));
	Если СтрНайти(Brief, "Договорённости (идентификаторы)") = 0 Тогда
		Ошибки.Добавить(Имя + ": brief missing heading 'Договорённости (идентификаторы)'");
	КонецЕсли;
	Эффективные = ?(JsonУтилиты.ЭтоМассив(Стадии), Стадии, ИменаСтадийПоУмолчанию());
	Если МассивСодержит(Эффективные, "analyst") Тогда
		PlanFiles = JsonУтилиты.ПолучитьПоле(Ожидание, "plan_files");
		Если Не МассивСодержит(?(JsonУтилиты.ЭтоМассив(PlanFiles), PlanFiles, Новый Массив), "agreements.md") Тогда
			Ошибки.Добавить(Имя + ": expect.plan_files must include agreements.md");
		КонецЕсли;
	КонецЕсли;
	Если МассивСодержит(Эффективные, "yaxunit") Тогда
		Yax = JsonУтилиты.ПолучитьПоле(Ожидание, "yaxunit");
		TestContains = JsonУтилиты.ПолучитьПоле(Ожидание, "test_contains");
		Если (TestContains = Неопределено Или (JsonУтилиты.ЭтоМассив(TestContains) И TestContains.Количество() = 0))
			И Не ЗначениеЗаполнено(JsonУтилиты.ПолучитьПоле(Yax, "procedure")) Тогда
			Ошибки.Добавить(Имя + ": yaxunit stage needs expect.test_contains or expect.yaxunit.procedure");
		КонецЕсли;
	КонецЕсли;
	Возврат Ошибки;
КонецФункции

Функция CfeГотово(Путь)
	Если Не Окружение.КаталогСуществует(Путь) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Окружение.ФайлСуществует(Окружение.ОбъединитьПуть(Путь, "Configuration.xml")) Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Окружение.СобратьФайлы(Путь, Массив1("Configuration.xml")).Количество() > 0;
КонецФункции

Функция СгенерированныйYaxunit(Дома, Fallback)
	Для Каждого Ключ Из СтрРазделить("implementer,yaxunit", ",", Ложь) Цикл
		Дом = Дома.Получить(Ключ);
		Если Дом = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Кандидат = Окружение.ОбъединитьПуть(Дом, "out", "cfe-tests");
		Если CfeГотово(Кандидат) Тогда
			Возврат Кандидат;
		КонецЕсли;
	КонецЦикла;
	Возврат Fallback;
КонецФункции

Процедура ЗаписатьЗаметкиЗадачи(NotesDir, TaskDir, RunId, СтрокаОтчёта, Ожидание, Дома)
	TaskId = Строка(JsonУтилиты.ПолучитьПоле(СтрокаОтчёта, "id", Окружение.ИмяФайла(TaskDir)));
	Строки = Новый Массив;
	Строки.Добавить("# " + TaskId + " — " + RunId);
	Строки.Добавить("");
	Строки.Добавить("- pass: `" + Строка(JsonУтилиты.ПолучитьПоле(СтрокаОтчёта, "pass")) + "`");
	Строки.Добавить("- agent_stop (CLI loop end, not pass): see stages below");
	Строки.Добавить("- platform (run-yaxunit.os): `" + Строка(JsonУтилиты.ПолучитьПоле(СтрокаОтчёта, "yaxunit")) + "`");
	Строки.Добавить("- error: `" + Строка(JsonУтилиты.ПолучитьПоле(СтрокаОтчёта, "error")) + "`");
	Строки.Добавить("- failures: " + JsonУтилиты.ВJSON(JsonУтилиты.ПолучитьПоле(СтрокаОтчёта, "failures")));
	Строки.Добавить("");
	Строки.Добавить("## expect (bank)");
	Строки.Добавить("");
	Строки.Добавить("```json");
	Строки.Добавить(JsonУтилиты.ВJSON(Ожидание));
	Строки.Добавить("```");
	Строки.Добавить("");
	Строки.Добавить("## stages");
	Строки.Добавить("");
	Стадии = JsonУтилиты.ПолучитьПоле(СтрокаОтчёта, "stages");
	Для Каждого Описание Из ОписаниеСтадий() Цикл
		Стадия = JsonУтилиты.ПолучитьПоле(Стадии, Описание.Имя);
		Если Не JsonУтилиты.ЭтоСоответствие(Стадия) Тогда
			Продолжить;
		КонецЕсли;
		Дом = Дома.Получить(Описание.Имя);
		Строки.Добавить("### " + Описание.Имя);
		Строки.Добавить("");
		Строки.Добавить("- agent_stop: `" + Строка(JsonУтилиты.ПолучитьПоле(Стадия, "stop_reason")) + "` (goal_reached = done=true, not contract pass)");
		Строки.Добавить("- usage: " + СтрокаUsage(JsonУтилиты.ПолучитьПоле(Стадия, "usage")));
		Строки.Добавить("- home: `" + Строка(Дом) + "`");
		Строки.Добавить("- result: " + Строка(JsonУтилиты.ПолучитьПоле(Стадия, "result")));
		Строки.Добавить("");
		Файлы = СписокOut(Дом);
		Если Файлы.Количество() > 0 Тогда
			Строки.Добавить("out/:");
			Для Каждого Отн Из Файлы Цикл
				Строки.Добавить("- `" + Отн + "`");
			КонецЦикла;
			Строки.Добавить("");
		КонецЕсли;
	КонецЦикла;
	Строки.Добавить("## where to look");
	Строки.Добавить("");
	Строки.Добавить("- task dir: `" + TaskDir + "`");
	Строки.Добавить("- logs: `" + Окружение.ОбъединитьПуть(TaskDir, "logs") + "`");
	Строки.Добавить("- platform work: `" + Окружение.ОбъединитьПуть(TaskDir, "yaxunit") + "`");
	Строки.Добавить("");
	Текст = СтрСоединить(Строки, Символы.ПС) + Символы.ПС;
	Окружение.ЗаписатьТекст(Окружение.ОбъединитьПуть(TaskDir, "NOTES.md"), Текст);
	DestDir = Окружение.ОбъединитьПуть(NotesDir, "runs", RunId);
	Окружение.ОбеспечитьКаталог(DestDir);
	Окружение.ЗаписатьТекст(Окружение.ОбъединитьПуть(DestDir, TaskId + ".md"), Текст);
КонецПроцедуры

Процедура ЗаписатьЗаметкиПрогона(RunDir, NotesDir, Отчёт)
	RunId = Строка(JsonУтилиты.ПолучитьПоле(Отчёт, "run_id", Окружение.ИмяФайла(RunDir)));
	Строки = Новый Массив;
	Строки.Добавить("# Run " + RunId);
	Строки.Добавить("");
	Строки.Добавить("- product: `" + Строка(JsonУтилиты.ПолучитьПоле(Отчёт, "product")) + "`");
	Строки.Добавить("- passed: " + Строка(JsonУтилиты.ПолучитьПоле(Отчёт, "passed")) + "  failed: " + Строка(JsonУтилиты.ПолучитьПоле(Отчёт, "failed")) + "  total: " + Строка(JsonУтилиты.ПолучитьПоле(Отчёт, "total")));
	Строки.Добавить("- report: `" + Окружение.ОбъединитьПуть(RunDir, "report.json") + "`");
	Строки.Добавить("");
	Строки.Добавить("## tasks");
	Строки.Добавить("");
	Для Каждого Задача Из JsonУтилиты.ПолучитьПоле(Отчёт, "tasks") Цикл
		Если Не JsonУтилиты.ЭтоСоответствие(Задача) Тогда
			Продолжить;
		КонецЕсли;
		Tid = JsonУтилиты.ПолучитьПоле(Задача, "id");
		Строки.Добавить("- `" + Tid + "`: pass=" + Строка(JsonУтилиты.ПолучитьПоле(Задача, "pass")) + " platform=" + Строка(JsonУтилиты.ПолучитьПоле(Задача, "yaxunit")) + " failures=" + JsonУтилиты.ВJSON(JsonУтилиты.ПолучитьПоле(Задача, "failures")));
		Строки.Добавить("  notes: `notes/runs/" + RunId + "/" + Tid + ".md`");
	КонецЦикла;
	Строки.Добавить("");
	Текст = СтрСоединить(Строки, Символы.ПС) + Символы.ПС;
	Окружение.ЗаписатьТекст(Окружение.ОбъединитьПуть(RunDir, "NOTES.md"), Текст);
	DestDir = Окружение.ОбъединитьПуть(NotesDir, "runs", RunId);
	Окружение.ОбеспечитьКаталог(DestDir);
	Окружение.ЗаписатьТекст(Окружение.ОбъединитьПуть(DestDir, "NOTES.md"), Текст);
КонецПроцедуры

Функция СписокOut(Дом)
	Результат = Новый Массив;
	Если Дом = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Out = Окружение.ОбъединитьПуть(Дом, "out");
	Если Не Окружение.КаталогСуществует(Out) Тогда
		Возврат Результат;
	КонецЕсли;
	Файлы = Окружение.СобратьФайлы(Out);
	Сч = 0;
	Для Каждого Путь Из Файлы Цикл
		Результат.Добавить(Окружение.ПозиксОтносительно(Out, Путь));
		Сч = Сч + 1;
		Если Сч >= 40 Тогда
			Результат.Добавить("…");
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция СтрокаUsage(Usage)
	Если Не JsonУтилиты.ЭтоСоответствие(Usage) Тогда
		Возврат "n/a";
	КонецЕсли;
	Части = Новый Массив;
	Для Каждого Ключ Из СтрРазделить("iterations,prompt_tokens,completion_tokens,total_tokens,elapsed_ms", ",", Ложь) Цикл
		Зн = JsonУтилиты.ПолучитьПоле(Usage, Ключ);
		Если Зн <> Неопределено Тогда
			Части.Добавить(Ключ + "=" + Строка(Зн));
		КонецЕсли;
	КонецЦикла;
	Если Части.Количество() = 0 Тогда
		Возврат "n/a";
	КонецЕсли;
	Возврат СтрСоединить(Части, ", ");
КонецФункции

Функция XmlКорректен(Путь)
	Чтение = Новый ЧтениеXML;
	Попытка
		Чтение.ОткрытьФайл(Путь);
		Пока Чтение.Прочитать() Цикл
		КонецЦикла;
		Чтение.Закрыть();
		Возврат Истина;
	Исключение
		Попытка
			Чтение.Закрыть();
		Исключение
		КонецПопытки;
		Возврат Ложь;
	КонецПопытки;
КонецФункции

Функция ОписаниеСтадий()
	Результат = Новый Массив;
	Результат.Добавить(Новый Структура("Имя,Агент", "analyst", "1c-analyst"));
	Результат.Добавить(Новый Структура("Имя,Агент", "yaxunit", "1c-yaxunit"));
	Результат.Добавить(Новый Структура("Имя,Агент", "coder", "1c-coder"));
	Результат.Добавить(Новый Структура("Имя,Агент", "implementer", "1c-implementer"));
	Возврат Результат;
КонецФункции

Функция ИменаСтадийПоУмолчанию()
	Результат = Новый Массив;
	Для Каждого Описание Из ОписаниеСтадий() Цикл
		Результат.Добавить(Описание.Имя);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ДокументыYaxunit()
	Возврат СтрРазделить("first-test.md,registration.md,assertions.md,features.md,transactions.md", ",", Ложь);
КонецФункции

Функция ПутьПротокола(КореньРепо)
	Возврат Окружение.ОбъединитьПуть(КореньРепо, "profiles", "1c-shared", "agreements-protocol.md");
КонецФункции

Функция МассивСодержит(Массив, Значение)
	Для Каждого Эл Из Массив Цикл
		Если Эл = Значение Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция Массив1(А)
	Результат = Новый Массив;
	Результат.Добавить(А);
	Возврат Результат;
КонецФункции
