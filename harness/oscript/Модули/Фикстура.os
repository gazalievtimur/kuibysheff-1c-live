// Генератор XML-фикстуры Склад. BSL не перезаписывается.

Функция Сгенерировать(КаталогHarness) Экспорт
	CF = Окружение.ОбъединитьПуть(КаталогHarness, "cf");
	CFE = Окружение.ОбъединитьПуть(КаталогHarness, "cfe", "YAxUnit_Tests_Sklad");
	ЗаписатьКонфигурацию(CF);
	ЗаписатьЯзык(CF);
	ЗаписатьРоль(CF);
	ЗаписатьПеречисление(CF);
	ЗаписатьСправочник(CF, "Номенклатура", "Номенклатура", Uid("nomen"), АтрибутыНоменклатуры());
	ЗаписатьСправочник(CF, "Контрагенты", "Контрагенты", Uid("kontr"), "");
	ЗаписатьСправочник(CF, "Склады", "Склады", Uid("sklad"), "");
	ЗаписатьРегистрСведений(CF);
	ЗаписатьРегистрНакопления(CF);
	ЗаписатьОбщийМодуль(CF, "ПроведениеДокументов", Uid("prov"));
	ЗаписатьОбщийМодуль(CF, "РаботаСЦенами", Uid("ceny_mod"));
	RR = "				<xr:Item xsi:type=""xr:MDObjectRef"">AccumulationRegister.ОстаткиТоваров</xr:Item>";
	ЗаписатьДокумент(CF, "ПриходТовара", Uid("prihod"), Uid("form_p"), RR);
	ЗаписатьДокумент(CF, "РасходТовара", Uid("rashod"), Uid("form_r"), RR);
	ЗаписатьHttpСервис(CF);
	ЗаписатьYaxunitCfe(CFE);
	Сообщить("OK: fixture written under " + CF + " and " + CFE);
	Возврат 0;
КонецФункции

Функция ПС()
	Возврат Символы.ПС;
КонецФункции

Функция NS()
	Возврат "xmlns=""http://v8.1c.ru/8.3/MDClasses"" xmlns:app=""http://v8.1c.ru/8.2/managed-application/core"" xmlns:cfg=""http://v8.1c.ru/8.1/data/enterprise/current-config"" xmlns:cmi=""http://v8.1c.ru/8.2/managed-application/cmi"" xmlns:ent=""http://v8.1c.ru/8.1/data/enterprise"" xmlns:lf=""http://v8.1c.ru/8.2/managed-application/logform"" xmlns:style=""http://v8.1c.ru/8.1/data/ui/style"" xmlns:sys=""http://v8.1c.ru/8.1/data/ui/fonts/system"" xmlns:v8=""http://v8.1c.ru/8.1/data/core"" xmlns:v8ui=""http://v8.1c.ru/8.1/data/ui"" xmlns:web=""http://v8.1c.ru/8.1/data/ui/colors/web"" xmlns:win=""http://v8.1c.ru/8.1/data/ui/colors/windows"" xmlns:xen=""http://v8.1c.ru/8.3/xcf/enums"" xmlns:xpr=""http://v8.1c.ru/8.3/xcf/predef"" xmlns:xr=""http://v8.1c.ru/8.3/xcf/readable"" xmlns:xs=""http://www.w3.org/2001/XMLSchema"" xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance"" version=""2.20""";
КонецФункции

Функция Uid(Ключ)
	Карта = Новый Соответствие;
	Карта.Вставить("cfg", "a1000001-0001-4000-8000-000000000001");
	Карта.Вставить("lang", "a1000001-0001-4000-8000-000000000002");
	Карта.Вставить("role", "a1000001-0001-4000-8000-000000000003");
	Карта.Вставить("enum", "a1000001-0001-4000-8000-000000000010");
	Карта.Вставить("nomen", "a1000001-0001-4000-8000-000000000020");
	Карта.Вставить("kontr", "a1000001-0001-4000-8000-000000000021");
	Карта.Вставить("sklad", "a1000001-0001-4000-8000-000000000022");
	Карта.Вставить("ceny", "a1000001-0001-4000-8000-000000000030");
	Карта.Вставить("ostatki", "a1000001-0001-4000-8000-000000000031");
	Карта.Вставить("prov", "a1000001-0001-4000-8000-000000000040");
	Карта.Вставить("ceny_mod", "a1000001-0001-4000-8000-000000000041");
	Карта.Вставить("prihod", "a1000001-0001-4000-8000-000000000050");
	Карта.Вставить("rashod", "a1000001-0001-4000-8000-000000000051");
	Карта.Вставить("http", "a1000001-0001-4000-8000-000000000060");
	Карта.Вставить("form_p", "a1000001-0001-4000-8000-000000000070");
	Карта.Вставить("form_r", "a1000001-0001-4000-8000-000000000071");
	Карта.Вставить("cfe", "b2000001-0001-4000-8000-000000000001");
	Возврат Карта.Получить(Ключ);
КонецФункции

Функция Syn(Текст)
	Возврат "<Synonym>" + ПС() + Символы.Таб + Символы.Таб + Символы.Таб + "<v8:item>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<v8:lang>ru</v8:lang>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<v8:content>" + Текст + "</v8:content>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "</v8:item>" + ПС()
		+ Символы.Таб + Символы.Таб + "</Synonym>";
КонецФункции

Процедура ЗаписатьФайл(Путь, Текст)
	Окружение.ЗаписатьТекст(Путь, СокрЛ(Текст));
КонецПроцедуры

Функция Типы(Префикс, Имя)
	Строки = Новый Массив;
	Для Каждого Пара Из СтрРазделить("Object|Object,Ref|Ref,Selection|Selection,List|List,Manager|Manager", ",", Ложь) Цикл
		Части = СтрРазделить(Пара, "|");
		Cat = Части[0];
		Suffix = Части[1];
		Tid = Uuid5.ИзИмени(Префикс + "." + Имя + "." + Suffix + ".t");
		Vid = Uuid5.ИзИмени(Префикс + "." + Имя + "." + Suffix + ".v");
		Строки.Добавить(Символы.Таб + Символы.Таб + Символы.Таб + "<xr:GeneratedType name=""" + Префикс + Suffix + "." + Имя + """ category=""" + Cat + """>");
		Строки.Добавить(Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<xr:TypeId>" + Tid + "</xr:TypeId>");
		Строки.Добавить(Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<xr:ValueId>" + Vid + "</xr:ValueId>");
		Строки.Добавить(Символы.Таб + Символы.Таб + Символы.Таб + "</xr:GeneratedType>");
	КонецЦикла;
	Возврат СтрСоединить(Строки, ПС());
КонецФункции

Функция Шапка()
	Возврат "<?xml version=""1.0"" encoding=""UTF-8""?>" + ПС() + "<MetaDataObject " + NS() + ">";
КонецФункции

Процедура ЗаписатьКонфигурацию(CF)
	Дети = Новый Массив;
	Для Каждого Строка Из СтрРазделить("Language:Русский,Role:ПолныеПрава,CommonModule:ПроведениеДокументов,CommonModule:РаботаСЦенами,HTTPService:ОбменСкладом,Catalog:Номенклатура,Catalog:Контрагенты,Catalog:Склады,Document:ПриходТовара,Document:РасходТовара,Enum:ВидыНоменклатуры,InformationRegister:ЦеныНоменклатуры,AccumulationRegister:ОстаткиТоваров", ",", Ложь) Цикл
		Части = СтрРазделить(Строка, ":");
		Дети.Добавить(Символы.Таб + Символы.Таб + Символы.Таб + "<" + Части[0] + ">" + Части[1] + "</" + Части[0] + ">");
	КонецЦикла;
	Текст = Шапка() + ПС()
		+ Символы.Таб + "<Configuration uuid=""" + Uid("cfg") + """>" + ПС()
		+ Символы.Таб + Символы.Таб + "<InternalInfo/>" + ПС()
		+ Символы.Таб + Символы.Таб + "<Properties>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<Name>Склад</Name>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Syn("Склад (live fixture)") + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<Comment>Kuibysheff 1c-live fixture — original toy warehouse CF</Comment>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<ConfigurationExtensionCompatibilityMode>Version8_3_23</ConfigurationExtensionCompatibilityMode>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<DefaultRunMode>ManagedApplication</DefaultRunMode>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<UsePurposes>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<v8:Value xsi:type=""app:ApplicationUsePurpose"">PlatformApplication</v8:Value>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "</UsePurposes>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<ScriptVariant>Russian</ScriptVariant>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<DefaultRoles>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<xr:Item xsi:type=""xr:MDObjectRef"">Role.ПолныеПрава</xr:Item>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "</DefaultRoles>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<Vendor>Kuibysheff Live</Vendor>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<Version>1.0.0</Version>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<DefaultLanguage>Language.Русский</DefaultLanguage>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<CompatibilityMode>Version8_3_23</CompatibilityMode>" + ПС()
		+ Символы.Таб + Символы.Таб + "</Properties>" + ПС()
		+ Символы.Таб + Символы.Таб + "<ChildObjects>" + ПС()
		+ СтрСоединить(Дети, ПС()) + ПС()
		+ Символы.Таб + Символы.Таб + "</ChildObjects>" + ПС()
		+ Символы.Таб + "</Configuration>" + ПС()
		+ "</MetaDataObject>" + ПС();
	ЗаписатьФайл(Окружение.ОбъединитьПуть(CF, "Configuration.xml"), Текст);
КонецПроцедуры

Процедура ЗаписатьЯзык(CF)
	Текст = Шапка() + ПС() + Символы.Таб + "<Language uuid=""" + Uid("lang") + """>" + ПС()
		+ Символы.Таб + Символы.Таб + "<Properties>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<Name>Русский</Name>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Syn("Русский") + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<LanguageCode>ru</LanguageCode>" + ПС()
		+ Символы.Таб + Символы.Таб + "</Properties>" + ПС()
		+ Символы.Таб + "</Language>" + ПС() + "</MetaDataObject>" + ПС();
	ЗаписатьФайл(Окружение.ОбъединитьПуть(CF, "Languages", "Русский.xml"), Текст);
КонецПроцедуры

Процедура ЗаписатьРоль(CF)
	Текст = Шапка() + ПС() + Символы.Таб + "<Role uuid=""" + Uid("role") + """>" + ПС()
		+ Символы.Таб + Символы.Таб + "<Properties>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<Name>ПолныеПрава</Name>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Syn("Полные права") + ПС()
		+ Символы.Таб + Символы.Таб + "</Properties>" + ПС()
		+ Символы.Таб + "</Role>" + ПС() + "</MetaDataObject>" + ПС();
	ЗаписатьФайл(Окружение.ОбъединитьПуть(CF, "Roles", "ПолныеПрава.xml"), Текст);
КонецПроцедуры

Процедура ЗаписатьПеречисление(CF)
	Текст = Шапка() + ПС() + Символы.Таб + "<Enum uuid=""" + Uid("enum") + """>" + ПС()
		+ Символы.Таб + Символы.Таб + "<InternalInfo>" + ПС() + Типы("Enum", "ВидыНоменклатуры") + ПС()
		+ Символы.Таб + Символы.Таб + "</InternalInfo>" + ПС()
		+ Символы.Таб + Символы.Таб + "<Properties>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<Name>ВидыНоменклатуры</Name>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Syn("Виды номенклатуры") + ПС()
		+ Символы.Таб + Символы.Таб + "</Properties>" + ПС()
		+ Символы.Таб + Символы.Таб + "<ChildObjects>" + ПС()
		+ ЗначениеПеречисления("enum.товар", "Товар") + ПС()
		+ ЗначениеПеречисления("enum.услуга", "Услуга") + ПС()
		+ Символы.Таб + Символы.Таб + "</ChildObjects>" + ПС()
		+ Символы.Таб + "</Enum>" + ПС() + "</MetaDataObject>" + ПС();
	ЗаписатьФайл(Окружение.ОбъединитьПуть(CF, "Enums", "ВидыНоменклатуры.xml"), Текст);
КонецПроцедуры

Функция ЗначениеПеречисления(КлючUuid, Имя)
	Возврат Символы.Таб + Символы.Таб + Символы.Таб + "<EnumValue uuid=""" + Uuid5.ИзИмени(КлючUuid) + """>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<Properties>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<Name>" + Имя + "</Name>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Syn(Имя) + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "</Properties>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "</EnumValue>";
КонецФункции

Процедура ЗаписатьСправочник(CF, Имя, Синоним, Ид, Extra)
	Текст = Шапка() + ПС() + Символы.Таб + "<Catalog uuid=""" + Ид + """>" + ПС()
		+ Символы.Таб + Символы.Таб + "<InternalInfo>" + ПС() + Типы("Catalog", Имя) + ПС()
		+ Символы.Таб + Символы.Таб + "</InternalInfo>" + ПС()
		+ Символы.Таб + Символы.Таб + "<Properties>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<Name>" + Имя + "</Name>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Syn(Синоним) + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<Hierarchical>false</Hierarchical>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<CodeLength>9</CodeLength>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<DescriptionLength>100</DescriptionLength>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<CodeType>String</CodeType>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<Autonumbering>true</Autonumbering>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<DefaultPresentation>AsDescription</DefaultPresentation>" + ПС()
		+ Символы.Таб + Символы.Таб + "</Properties>" + ПС()
		+ Символы.Таб + Символы.Таб + "<ChildObjects>" + ПС() + Extra
		+ Символы.Таб + Символы.Таб + "</ChildObjects>" + ПС()
		+ Символы.Таб + "</Catalog>" + ПС() + "</MetaDataObject>" + ПС();
	ЗаписатьФайл(Окружение.ОбъединитьПуть(CF, "Catalogs", Имя + ".xml"), Текст);
КонецПроцедуры

Функция АтрибутыНоменклатуры()
	Возврат Символы.Таб + Символы.Таб + Символы.Таб + "<Attribute uuid=""" + Uuid5.ИзИмени("nomen.артикул") + """>" + ПС()
		+ СвойстваАтрибутаСтрока("Артикул", "Артикул", 50)
		+ Символы.Таб + Символы.Таб + Символы.Таб + "</Attribute>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<Attribute uuid=""" + Uuid5.ИзИмени("nomen.вид") + """>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<Properties>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<Name>ВидНоменклатуры</Name>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Syn("Вид номенклатуры") + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<Type>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<v8:Type>cfg:EnumRef.ВидыНоменклатуры</v8:Type>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "</Type>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "</Properties>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "</Attribute>" + ПС();
КонецФункции

Функция СвойстваАтрибутаСтрока(Имя, Синоним, Длина)
	Возврат Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<Properties>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<Name>" + Имя + "</Name>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Syn(Синоним) + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<Type>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<v8:Type>xs:string</v8:Type>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<v8:StringQualifiers>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<v8:Length>" + Строка(Длина) + "</v8:Length>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "</v8:StringQualifiers>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "</Type>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "</Properties>" + ПС();
КонецФункции

Процедура ЗаписатьРегистрСведений(CF)
	Текст = Шапка() + ПС() + Символы.Таб + "<InformationRegister uuid=""" + Uid("ceny") + """>" + ПС()
		+ Символы.Таб + Символы.Таб + "<InternalInfo>" + ПС() + Типы("InformationRegister", "ЦеныНоменклатуры") + ПС()
		+ Символы.Таб + Символы.Таб + "</InternalInfo>" + ПС()
		+ Символы.Таб + Символы.Таб + "<Properties>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<Name>ЦеныНоменклатуры</Name>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Syn("Цены номенклатуры") + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<InformationRegisterPeriodicity>Day</InformationRegisterPeriodicity>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<WriteMode>Independent</WriteMode>" + ПС()
		+ Символы.Таб + Символы.Таб + "</Properties>" + ПС()
		+ Символы.Таб + Символы.Таб + "<ChildObjects>" + ПС()
		+ Измерение("ceny.dim.nomen", "Номенклатура", "cfg:CatalogRef.Номенклатура") + ПС()
		+ Ресурс("ceny.res.цена", "Цена", 15, 2) + ПС()
		+ Символы.Таб + Символы.Таб + "</ChildObjects>" + ПС()
		+ Символы.Таб + "</InformationRegister>" + ПС() + "</MetaDataObject>" + ПС();
	ЗаписатьФайл(Окружение.ОбъединитьПуть(CF, "InformationRegisters", "ЦеныНоменклатуры.xml"), Текст);
КонецПроцедуры

Процедура ЗаписатьРегистрНакопления(CF)
	Текст = Шапка() + ПС() + Символы.Таб + "<AccumulationRegister uuid=""" + Uid("ostatki") + """>" + ПС()
		+ Символы.Таб + Символы.Таб + "<InternalInfo>" + ПС() + Типы("AccumulationRegister", "ОстаткиТоваров") + ПС()
		+ Символы.Таб + Символы.Таб + "</InternalInfo>" + ПС()
		+ Символы.Таб + Символы.Таб + "<Properties>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<Name>ОстаткиТоваров</Name>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Syn("Остатки товаров") + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<RegisterType>Balance</RegisterType>" + ПС()
		+ Символы.Таб + Символы.Таб + "</Properties>" + ПС()
		+ Символы.Таб + Символы.Таб + "<ChildObjects>" + ПС()
		+ Измерение("ost.dim.nomen", "Номенклатура", "cfg:CatalogRef.Номенклатура") + ПС()
		+ Измерение("ost.dim.sklad", "Склад", "cfg:CatalogRef.Склады") + ПС()
		+ Ресурс("ost.res.qty", "Количество", 15, 3) + ПС()
		+ Символы.Таб + Символы.Таб + "</ChildObjects>" + ПС()
		+ Символы.Таб + "</AccumulationRegister>" + ПС() + "</MetaDataObject>" + ПС();
	ЗаписатьФайл(Окружение.ОбъединитьПуть(CF, "AccumulationRegisters", "ОстаткиТоваров.xml"), Текст);
КонецПроцедуры

Функция Измерение(КлючUuid, Имя, ТипСсылки)
	Возврат Символы.Таб + Символы.Таб + Символы.Таб + "<Dimension uuid=""" + Uuid5.ИзИмени(КлючUuid) + """>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<Properties>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<Name>" + Имя + "</Name>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Syn(Имя) + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<Type>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<v8:Type>" + ТипСсылки + "</v8:Type>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "</Type>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "</Properties>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "</Dimension>";
КонецФункции

Функция Ресурс(КлючUuid, Имя, Целых, Дробных)
	Возврат Символы.Таб + Символы.Таб + Символы.Таб + "<Resource uuid=""" + Uuid5.ИзИмени(КлючUuid) + """>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<Properties>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<Name>" + Имя + "</Name>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Syn(Имя) + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<Type>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<v8:Type>xs:decimal</v8:Type>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<v8:NumberQualifiers>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<v8:Digits>" + Строка(Целых) + "</v8:Digits>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<v8:FractionDigits>" + Строка(Дробных) + "</v8:FractionDigits>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "</v8:NumberQualifiers>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "</Type>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "</Properties>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "</Resource>";
КонецФункции

Процедура ЗаписатьОбщийМодуль(CF, Имя, Ид)
	Текст = Шапка() + ПС() + Символы.Таб + "<CommonModule uuid=""" + Ид + """>" + ПС()
		+ Символы.Таб + Символы.Таб + "<Properties>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<Name>" + Имя + "</Name>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Syn(Имя) + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<Server>true</Server>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<ClientManagedApplication>false</ClientManagedApplication>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<ExternalConnection>false</ExternalConnection>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<ClientOrdinaryApplication>false</ClientOrdinaryApplication>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<ServerCall>true</ServerCall>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<Global>false</Global>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<Privileged>false</Privileged>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<ReturnValuesReuse>DontUse</ReturnValuesReuse>" + ПС()
		+ Символы.Таб + Символы.Таб + "</Properties>" + ПС()
		+ Символы.Таб + "</CommonModule>" + ПС() + "</MetaDataObject>" + ПС();
	ЗаписатьФайл(Окружение.ОбъединитьПуть(CF, "CommonModules", Имя + ".xml"), Текст);
КонецПроцедуры

Процедура ЗаписатьДокумент(CF, Имя, Ид, FormUid, RegisterRecords)
	Текст = Шапка() + ПС() + Символы.Таб + "<Document uuid=""" + Ид + """>" + ПС()
		+ Символы.Таб + Символы.Таб + "<InternalInfo>" + ПС() + Типы("Document", Имя) + ПС()
		+ Символы.Таб + Символы.Таб + "</InternalInfo>" + ПС()
		+ Символы.Таб + Символы.Таб + "<Properties>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<Name>" + Имя + "</Name>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Syn(Имя) + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<NumberType>String</NumberType>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<NumberLength>11</NumberLength>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<NumberAllowedLength>Variable</NumberAllowedLength>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<Posting>Allow</Posting>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<RealTimePosting>Allow</RealTimePosting>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<RegisterRecordsDeletion>AutoDelete</RegisterRecordsDeletion>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<RegisterRecordsWritingOnPost>WriteSelected</RegisterRecordsWritingOnPost>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<PostInPrivilegedMode>true</PostInPrivilegedMode>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<UnpostInPrivilegedMode>true</UnpostInPrivilegedMode>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<RegisterRecords>" + ПС() + RegisterRecords + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "</RegisterRecords>" + ПС()
		+ Символы.Таб + Символы.Таб + "</Properties>" + ПС()
		+ Символы.Таб + Символы.Таб + "<ChildObjects>" + ПС()
		+ АтрибутСсылки(Имя + ".склад", "Склад", "cfg:CatalogRef.Склады", Истина) + ПС()
		+ АтрибутСсылки(Имя + ".контрагент", "Контрагент", "cfg:CatalogRef.Контрагенты", Ложь) + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<Form>ФормаДокумента</Form>" + ПС()
		+ ТабличнаяЧастьТовары(Имя) + ПС()
		+ Символы.Таб + Символы.Таб + "</ChildObjects>" + ПС()
		+ Символы.Таб + "</Document>" + ПС() + "</MetaDataObject>" + ПС();
	ЗаписатьФайл(Окружение.ОбъединитьПуть(CF, "Documents", Имя + ".xml"), Текст);
	Форма = Шапка() + ПС() + Символы.Таб + "<Form uuid=""" + FormUid + """>" + ПС()
		+ Символы.Таб + Символы.Таб + "<Properties>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<Name>ФормаДокумента</Name>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Syn("Форма документа") + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<FormType>Managed</FormType>" + ПС()
		+ Символы.Таб + Символы.Таб + "</Properties>" + ПС()
		+ Символы.Таб + "</Form>" + ПС() + "</MetaDataObject>" + ПС();
	ЗаписатьФайл(Окружение.ОбъединитьПуть(CF, "Documents", Имя, "Forms", "ФормаДокумента.xml"), Форма);
КонецПроцедуры

Функция АтрибутСсылки(КлючUuid, Имя, ТипСсылки, ПроверкаЗаполнения)
	Доп = "";
	Если ПроверкаЗаполнения Тогда
		Доп = Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<FillChecking>ShowError</FillChecking>" + ПС();
	КонецЕсли;
	Возврат Символы.Таб + Символы.Таб + Символы.Таб + "<Attribute uuid=""" + Uuid5.ИзИмени(КлючUuid) + """>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<Properties>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<Name>" + Имя + "</Name>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Syn(Имя) + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<Type>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<v8:Type>" + ТипСсылки + "</v8:Type>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "</Type>" + ПС()
		+ Доп
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "</Properties>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "</Attribute>";
КонецФункции

Функция ТабличнаяЧастьТовары(Имя)
	Возврат Символы.Таб + Символы.Таб + Символы.Таб + "<TabularSection uuid=""" + Uuid5.ИзИмени(Имя + ".тч") + """>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<InternalInfo>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<xr:GeneratedType name=""DocumentTabularSection." + Имя + ".Товары"" category=""TabularSection"">" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<xr:TypeId>" + Uuid5.ИзИмени(Имя + ".тч.t") + "</xr:TypeId>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<xr:ValueId>" + Uuid5.ИзИмени(Имя + ".тч.v") + "</xr:ValueId>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "</xr:GeneratedType>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<xr:GeneratedType name=""DocumentTabularSectionRow." + Имя + ".Товары"" category=""TabularSectionRow"">" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<xr:TypeId>" + Uuid5.ИзИмени(Имя + ".тч.row.t") + "</xr:TypeId>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<xr:ValueId>" + Uuid5.ИзИмени(Имя + ".тч.row.v") + "</xr:ValueId>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "</xr:GeneratedType>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "</InternalInfo>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<Properties>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<Name>Товары</Name>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Syn("Товары") + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "</Properties>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<ChildObjects>" + ПС()
		+ АтрибутТЧ(Имя + ".тч.nomen", "Номенклатура", "cfg:CatalogRef.Номенклатура", 0, 0) + ПС()
		+ АтрибутТЧ(Имя + ".тч.qty", "Количество", "", 15, 3) + ПС()
		+ АтрибутТЧ(Имя + ".тч.цена", "Цена", "", 15, 2) + ПС()
		+ АтрибутТЧ(Имя + ".тч.сумма", "Сумма", "", 15, 2) + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "</ChildObjects>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "</TabularSection>";
КонецФункции

Функция АтрибутТЧ(КлючUuid, Имя, ТипСсылки, Целых, Дробных)
	Если ЗначениеЗаполнено(ТипСсылки) Тогда
		ТипБлок = Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<v8:Type>" + ТипСсылки + "</v8:Type>" + ПС();
	Иначе
		ТипБлок = Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<v8:Type>xs:decimal</v8:Type>" + ПС()
			+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<v8:NumberQualifiers>" + ПС()
			+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<v8:Digits>" + Строка(Целых) + "</v8:Digits>" + ПС()
			+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<v8:FractionDigits>" + Строка(Дробных) + "</v8:FractionDigits>" + ПС()
			+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "</v8:NumberQualifiers>" + ПС();
	КонецЕсли;
	Возврат Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<Attribute uuid=""" + Uuid5.ИзИмени(КлючUuid) + """>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<Properties>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<Name>" + Имя + "</Name>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Syn(Имя) + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<Type>" + ПС()
		+ ТипБлок
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "</Type>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "</Properties>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "</Attribute>";
КонецФункции

Процедура ЗаписатьHttpСервис(CF)
	Текст = Шапка() + ПС() + Символы.Таб + "<HTTPService uuid=""" + Uid("http") + """>" + ПС()
		+ Символы.Таб + Символы.Таб + "<Properties>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<Name>ОбменСкладом</Name>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Syn("Обмен складом") + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<RootURL>warehouse</RootURL>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<ReuseSessions>AutoUse</ReuseSessions>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<SessionMaxAge>20</SessionMaxAge>" + ПС()
		+ Символы.Таб + Символы.Таб + "</Properties>" + ПС()
		+ Символы.Таб + Символы.Таб + "<ChildObjects>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<URLTemplate uuid=""" + Uuid5.ИзИмени("http.остатки") + """>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<Properties>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<Name>Остатки</Name>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Syn("Остатки") + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<Template>/остатки</Template>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "</Properties>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<ChildObjects>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<Method uuid=""" + Uuid5.ИзИмени("http.остатки.get") + """>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<Properties>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<Name>GET</Name>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Syn("GET") + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + Символы.Таб + "<HTTPMethod>GET</HTTPMethod>" + ПС()
