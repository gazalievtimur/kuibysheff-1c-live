Процедура ЗаписатьYaxunitCfe(CFE)
	Текст = Шапка() + ПС() + Символы.Таб + "<Configuration uuid=""" + Uid("cfe") + """>" + ПС()
		+ Символы.Таб + Символы.Таб + "<InternalInfo/>" + ПС()
		+ Символы.Таб + Символы.Таб + "<Properties>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<ObjectBelonging>Adopted</ObjectBelonging>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<Name>YAxUnit_Tests_Sklad</Name>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + Syn("YAxUnit Tests Склад") + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<ConfigurationExtensionPurpose>Customization</ConfigurationExtensionPurpose>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<KeepMappingToExtendedConfigurationObjectsByIDs>true</KeepMappingToExtendedConfigurationObjectsByIDs>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<NamePrefix>СкладТест_</NamePrefix>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<ConfigurationExtensionCompatibilityMode>Version8_3_23</ConfigurationExtensionCompatibilityMode>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<ScriptVariant>Russian</ScriptVariant>" + ПС()
		+ Символы.Таб + Символы.Таб + "</Properties>" + ПС()
		+ Символы.Таб + Символы.Таб + "<ChildObjects>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<CommonModule>СкладТест_РасходТовара</CommonModule>" + ПС()
		+ Символы.Таб + Символы.Таб + Символы.Таб + "<CommonModule>СкладТест_HTTP</CommonModule>" + ПС()
		+ Символы.Таб + Символы.Таб + "</ChildObjects>" + ПС()
		+ Символы.Таб + "</Configuration>" + ПС() + "</MetaDataObject>" + ПС();
	ЗаписатьФайл(Окружение.ОбъединитьПуть(CFE, "Configuration.xml"), Текст);
	Для Каждого Имя Из СтрРазделить("СкладТест_РасходТовара,СкладТест_HTTP", ",", Ложь) Цикл
		М = Шапка() + ПС() + Символы.Таб + "<CommonModule uuid=""" + Uuid5.ИзИмени("cfe." + Имя) + """>" + ПС()
			+ Символы.Таб + Символы.Таб + "<Properties>" + ПС()
			+ Символы.Таб + Символы.Таб + Символы.Таб + "<Name>" + Имя + "</Name>" + ПС()
			+ Символы.Таб + Символы.Таб + Символы.Таб + Syn(Имя) + ПС()
			+ Символы.Таб + Символы.Таб + Символы.Таб + "<Server>true</Server>" + ПС()
			+ Символы.Таб + Символы.Таб + Символы.Таб + "<ServerCall>true</ServerCall>" + ПС()
			+ Символы.Таб + Символы.Таб + Символы.Таб + "<Global>false</Global>" + ПС()
			+ Символы.Таб + Символы.Таб + "</Properties>" + ПС()
			+ Символы.Таб + "</CommonModule>" + ПС() + "</MetaDataObject>" + ПС();
		ЗаписатьФайл(Окружение.ОбъединитьПуть(CFE, "CommonModules", Имя + ".xml"), М);
	КонецЦикла;
КонецПроцедуры
