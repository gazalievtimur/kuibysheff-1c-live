// Разбор CLI: eval и лаунчер.

Функция РазобратьEval(Аргументы) Экспорт
	Параметры = Новый Структура;
	Параметры.Вставить("RepoRoot", "");
	Параметры.Вставить("BankDir", "");
	Параметры.Вставить("CfDir", "");
	Параметры.Вставить("YaxunitDir", "");
	Параметры.Вставить("RunsRoot", "");
	Параметры.Вставить("Config", "");
	Параметры.Вставить("AgentBin", "");
	Параметры.Вставить("TaskIds", Новый Массив);
	Параметры.Вставить("All", Ложь);
	Параметры.Вставить("DryRun", Ложь);
	Параметры.Вставить("RequirePlatform", Ложь);
	Параметры.Вставить("WithSearxng", Ложь);
	Параметры.Вставить("SkipBuild", Ложь);
	Инд = 0;
	Пока Инд < Аргументы.Количество() Цикл
		Арг = Аргументы[Инд];
		Если Арг = "--dry-run" Тогда
			Параметры.DryRun = Истина;
		ИначеЕсли Арг = "--all" Тогда
			Параметры.All = Истина;
		ИначеЕсли Арг = "--require-platform" Тогда
			Параметры.RequirePlatform = Истина;
		ИначеЕсли Арг = "--with-searxng" Тогда
			Параметры.WithSearxng = Истина;
		ИначеЕсли Арг = "--skip-build" Тогда
			Параметры.SkipBuild = Истина;
		ИначеЕсли Арг = "--repo-root" Тогда
			Инд = Инд + 1;
			Параметры.RepoRoot = Аргументы[Инд];
		ИначеЕсли Арг = "--bank-dir" Тогда
			Инд = Инд + 1;
			Параметры.BankDir = Аргументы[Инд];
		ИначеЕсли Арг = "--cf-dir" Тогда
			Инд = Инд + 1;
			Параметры.CfDir = Аргументы[Инд];
		ИначеЕсли Арг = "--yaxunit-dir" Тогда
			Инд = Инд + 1;
			Параметры.YaxunitDir = Аргументы[Инд];
		ИначеЕсли Арг = "--runs-root" Тогда
			Инд = Инд + 1;
			Параметры.RunsRoot = Аргументы[Инд];
		ИначеЕсли Арг = "--config" Тогда
			Инд = Инд + 1;
			Параметры.Config = Аргументы[Инд];
		ИначеЕсли Арг = "--agent-bin" Тогда
			Инд = Инд + 1;
			Параметры.AgentBin = Аргументы[Инд];
		ИначеЕсли Арг = "--task-id" Тогда
			Инд = Инд + 1;
			Параметры.TaskIds.Добавить(Аргументы[Инд]);
		Иначе
			ВызватьИсключение "unknown arg: " + Арг;
		КонецЕсли;
		Инд = Инд + 1;
	КонецЦикла;
	Возврат Параметры;
КонецФункции
