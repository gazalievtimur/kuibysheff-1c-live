// SHA256 дерева CF: posix-относительный путь + NUL + байты файла + NUL.

Функция Отпечаток(Корень) Экспорт
	Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
	Если Не Окружение.КаталогСуществует(Корень) Тогда
		Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеш.ХешСумма));
	КонецЕсли;
	Пропуски = Новый Соответствие;
	Пропуски.Вставить(".code-index", Истина);
	Пропуски.Вставить("__pycache__", Истина);
	Пропуски.Вставить(".git", Истина);
	Файлы = Новый Массив;
	Собрать(Корень, Корень, Пропуски, Файлы);
	Ключи = Новый Массив;
	Для Каждого Описание Из Файлы Цикл
		Ключи.Добавить(Описание.Относительный);
	КонецЦикла;
	Ключи = Окружение.СортироватьСтроки(Ключи);
	ПоФайлам = Новый Соответствие;
	Для Каждого Описание Из Файлы Цикл
		ПоФайлам.Вставить(Описание.Относительный, Описание.Полный);
	КонецЦикла;
	Нул = ПолучитьДвоичныеДанныеИзСтроки(Символ(0), КодировкаТекста.UTF8);
	Для Каждого Относительный Из Ключи Цикл
		Хеш.Добавить(ПолучитьДвоичныеДанныеИзСтроки(Относительный, КодировкаТекста.UTF8));
		Хеш.Добавить(Нул);
		Хеш.Добавить(Новый ДвоичныеДанные(ПоФайлам.Получить(Относительный)));
		Хеш.Добавить(Нул);
	КонецЦикла;
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеш.ХешСумма));
КонецФункции

Процедура Собрать(Текущий, Корень, Пропуски, Файлы)
	Найденные = НайтиФайлы(Текущий, "*");
	Для Каждого Элемент Из Найденные Цикл
		Если Элемент.ЭтоКаталог() Тогда
			Если Пропуски.Получить(Элемент.Имя) = Истина Тогда
				Продолжить;
			КонецЕсли;
			Собрать(Элемент.ПолноеИмя, Корень, Пропуски, Файлы);
		ИначеЕсли Элемент.ЭтоФайл() Тогда
			Описание = Новый Структура("Относительный,Полный");
			Описание.Относительный = Окружение.ПозиксОтносительно(Корень, Элемент.ПолноеИмя);
			Описание.Полный = Элемент.ПолноеИмя;
			Файлы.Добавить(Описание);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
