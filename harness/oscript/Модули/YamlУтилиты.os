// Скаляр YAML как в прежнем eval: regex, не полный парсер.

Функция Скаляр(Текст, Ключ, ПоУмолчанию = "") Экспорт
	КлючЭкранированный = СтрЗаменить(СтрЗаменить(Ключ, "\", "\\"), ".", "\.");
	Шаблоны = Новый Массив;
	Шаблоны.Добавить("^\s*" + КлючЭкранированный + ":\s*""([^""]*)""");
	Шаблоны.Добавить("^\s*" + КлючЭкранированный + ":\s*'([^']*)'");
	Шаблоны.Добавить("^\s*" + КлючЭкранированный + ":\s*([^#\r\n]+)");
	Для Каждого Шаблон Из Шаблоны Цикл
		РВ = Новый РегулярноеВыражение(Шаблон);
		РВ.Многострочный = Истина;
		Совпадения = РВ.НайтиСовпадения(Текст);
		Если Совпадения.Количество() > 0 И Совпадения[0].Группы.Количество() > 1 Тогда
			Возврат СокрЛП(Совпадения[0].Группы[1].Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат ПоУмолчанию;
КонецФункции
