#Использовать "../harness/oscript"

Процедура Главная()
	AgentBin = "";
	Собирать = Ложь;
	Инд = 0;
	Аргументы = АргументыКоманднойСтроки;
	Пока Инд < Аргументы.Количество() Цикл
		Арг = Аргументы[Инд];
		Если Арг = "--build" Тогда
			Собирать = Истина;
		ИначеЕсли Арг = "--agent-bin" Тогда
			Инд = Инд + 1;
			AgentBin = Аргументы[Инд];
		ИначеЕсли Арг = "-h" Или Арг = "--help" Тогда
			Сообщить("Usage: resolve-kbshff.os [--agent-bin PATH] [--build]");
			ЗавершитьРаботу(0);
		Иначе
			Сообщить("Unknown argument: " + Арг);
			ЗавершитьРаботу(2);
		КонецЕсли;
		Инд = Инд + 1;
	КонецЦикла;
	Корень = Окружение.РодительскийКаталог(ТекущийСценарий().Каталог);
	Попытка
		Путь = РазрешениеKbshff.НайтиБинарник(Корень, AgentBin, Собирать);
		Сообщить(Путь);
		ЗавершитьРаботу(0);
	Исключение
		Сообщить(ОписаниеОшибки());
		ЗавершитьРаботу(1);
	КонецПопытки;
КонецПроцедуры

Главная();
