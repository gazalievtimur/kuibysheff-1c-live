# Provider (example: OpenAI-compatible)
OPENAI_API_KEY=

# 1C MCP
# sntx_sem: https://github.com/gybson63/1c-sntx-sem
# code-index / bsl-indexer: https://github.com/Regsorm/code-index-mcp
SNTX_SEM_CONFIG=
BSL_INDEXER=

# BSL Language Server MCP (ЗУП-style; required for yaxunit/coder/implementer)
# Upstream JAR: https://github.com/1c-syntax/bsl-language-server
# BSL_LS_MCP=%USERPROFILE%\.claude\bsl-ls-mcp\server.js
# BSL_LS_JAR=%USERPROFILE%\.claude\bsl-ls\bsl-language-server.jar
# JAVA_HOME=

# Optional overrides
# SNTX_SEM_PYTHON=
# KBSHFF_BIN=
# KUIBYSHEFF_SRC=
# CODE_INDEX_HOME=
