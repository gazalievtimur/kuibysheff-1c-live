# Провайдер (OpenAI-compatible). Ключ — только здесь, не в YAML и не в argv CLI.
# Канон применения: kbshff config --project-root <DIR> --agent <ID> provider set
#   --base-url ... --model ... --api-key-env OPENAI_API_KEY
# Один base_url / ключ; модель — отдельно на каждого агента конвейера.
# См. docs/howto-pipeline.md и: kbshff help config
KBSHFF_PROVIDER_BASE_URL=https://api.openai.com/v1
KBSHFF_PROVIDER_MODEL=gpt-4o
KBSHFF_PROVIDER_MODEL_1C_ANALYST=gpt-4o
KBSHFF_PROVIDER_MODEL_1C_YAXUNIT=gpt-4o
KBSHFF_PROVIDER_MODEL_1C_CODER=gpt-4o
KBSHFF_PROVIDER_MODEL_1C_IMPLEMENTER=gpt-4o
KBSHFF_PROVIDER_API_KEY_ENV=OPENAI_API_KEY
OPENAI_API_KEY=
# POLZA_API_KEY=
# DEEPSEEK_API_KEY=

# MCP 1С (scripts/install.ps1 заполняет абсолютные пути)
# sntx_sem: https://github.com/gybson63/1c-sntx-sem
# Harness — OneScript; Python нужен только процессу MCP sntx_sem
# (SNTX_SEM_PYTHON, 1c-sntx-sem/.venv/.../python, или sntx-sem в PATH).
# code-index / bsl-indexer: https://github.com/Regsorm/code-index-mcp
SNTX_SEM_CONFIG=
SNTX_SEM_PYTHON=
BSL_INDEXER=

# MCP BSL Language Server (опционально: нужен Node + Java 17+)
# Мост в репозитории: tools/bsl-ls-mcp/server.js (npm install при install, если есть Node)
# JAR: tools/bsl-ls/bsl-language-server.jar или %USERPROFILE%\.claude\bsl-ls\
# Upstream: https://github.com/1c-syntax/bsl-language-server
# Без Node/Java install пропускает штатный BSL LS — можно подставить свой MCP.
BSL_LS_MCP=
BSL_LS_JAR=
# JAVA_HOME=

# Опциональные переопределения
# KBSHFF_BIN=
# KUIBYSHEFF_SRC=
# CODE_INDEX_HOME=
